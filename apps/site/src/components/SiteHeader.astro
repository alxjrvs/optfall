---
/**
 * The bar at the top of every page except the front door.
 *
 * WHAT IT FIXES. Optfall had no persistent navigation at all: every page was a
 * bare column, so searching a second time meant going back to `/` and starting
 * over. Scryfall puts a search bar at the top of the results page and every
 * card page for exactly this reason — a reference tool is used in bursts of
 * several lookups, and the second lookup should not cost a navigation.
 *
 * IT IS A PLAIN FORM, NOT THE TYPEAHEAD, and that is deliberate rather than
 * lazy. The typeahead ships a names index — about 150 KB — and putting it in a
 * layout would put it on all 7,000 pages so that a reader who is not searching
 * still pays for the ability to. This is a `GET` to `/search`, which needs no
 * JavaScript, no index and no island; the door is still where the assisted
 * search lives.
 *
 * IT IS ABSENT ON THE FRONT DOOR. That page IS the search field, and a second
 * one above it would be the same control twice — Scryfall does not carry the
 * bar on its landing page either.
 */
interface Props {
  /** The nav item to mark as current, if any. */
  section?: "cards" | "sets" | "rules";
}

const { section } = Astro.props;

/*
 * Four destinations, which is the whole site. A nav that needs a submenu is a
 * nav describing a product with more surfaces than this one has.
 */
const LINKS: readonly { href: string; label: string; key?: Props["section"] }[] = [
  { href: "/search", label: "Cards", key: "cards" },
  { href: "/sets", label: "Sets", key: "sets" },
  { href: "/cr", label: "Rules", key: "rules" },
  { href: "/random", label: "Random" },
];
---

<header class="bar">
  <a class="wordmark" href="/">Optfall</a>

  <!--
    A real GET to the results page, so it works with scripting off and a
    submitted query lands on a shareable address. No island, no index.
  -->
  <form class="find" role="search" aria-label="Flesh and Blood cards" action="/search" method="get">
    <label class="sr" for="site-search">Search the cards</label>
    <input
      id="site-search"
      class="field"
      name="q"
      type="search"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
      placeholder="Search cards"
    />
  </form>

  <nav class="links" aria-label="Sections">
    {
      LINKS.map((link) => (
        <a
          href={link.href}
          aria-current={link.key !== undefined && link.key === section ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--of-space-base) var(--of-space-loose);
    padding-block: var(--of-space-base);
    margin-block-end: var(--of-space-loosest);
    border-block-end: var(--of-ornament-rule-width) solid var(--of-color-rule);
  }

  .wordmark {
    font-size: var(--of-type-size-small);
    font-weight: var(--of-type-weight-medium);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
    text-decoration: none;
    flex: 0 0 auto;
  }

  .wordmark:hover {
    color: var(--of-color-ink);
  }

  /* Takes the middle and gives it back when the bar wraps on a narrow screen. */
  .find {
    flex: 1 1 var(--of-card-face-thumb);
    min-inline-size: 0;
  }

  .field {
    inline-size: 100%;
    padding: var(--of-space-tighter) var(--of-space-tight);
    border: var(--of-bevel-width) solid var(--of-color-rule);
    border-radius: var(--of-bevel-radius);
    background: var(--of-color-sunken);
    color: var(--of-color-ink);
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-small);
  }

  .field::placeholder {
    color: var(--of-color-ink-faint);
  }

  .field:focus {
    outline: calc(var(--of-bevel-width) * 2) solid var(--of-color-focus);
    outline-offset: var(--of-space-tightest);
  }

  .field::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .links {
    display: flex;
    gap: var(--of-space-loose);
    flex: 0 0 auto;
    font-size: var(--of-type-size-small);
  }

  .links a {
    color: var(--of-color-ink-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--of-color-ink);
  }

  /* The current section is marked by ink and a rule, never by colour alone. */
  .links a[aria-current="page"] {
    color: var(--of-color-ink);
    box-shadow: inset 0 calc(-1 * var(--of-bevel-width)) 0 0 var(--of-color-accent);
  }

  /* Visible to a screen reader, not on screen: the placeholder is not a label,
     and a field whose only name is its placeholder loses that name the moment
     somebody types into it. */
  .sr {
    position: absolute;
    inline-size: var(--of-space-hair);
    block-size: var(--of-space-hair);
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
