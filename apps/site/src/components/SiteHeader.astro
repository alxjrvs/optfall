---
/**
 * The bar at the top of every page except the front door.
 *
 * WHAT IT FIXES. Optfall had no persistent navigation at all: every page was a
 * bare column, so searching a second time meant going back to `/` and starting
 * over. Scryfall puts a search bar at the top of the results page and every
 * card page for exactly this reason — a reference tool is used in bursts of
 * several lookups, and the second lookup should not cost a navigation.
 *
 * IT IS A PLAIN FORM, NOT THE TYPEAHEAD, and that is deliberate rather than
 * lazy. The typeahead ships a names index — about 150 KB — and putting it in a
 * layout would put it on all 7,000 pages so that a reader who is not searching
 * still pays for the ability to. This is a `GET` to `/search`, which needs no
 * JavaScript, no index and no island; the door is still where the assisted
 * search lives.
 *
 * IT IS ABSENT ON THE FRONT DOOR. That page IS the search field, and a second
 * one above it would be the same control twice — Scryfall does not carry the
 * bar on its landing page either.
 *
 * THE WORDMARK CARRIES THE MARK. This bar is on every page but one, so it is
 * the only place a logo can appear *everywhere* — and it shipped as the word
 * "Optfall" alone, which meant the mark `docs/DESIGN.md` builds an entire
 * section around rendered on no surface at all. It is `sm` and decorative: the
 * link text already says the name, and a `role="img"` repeating it would make
 * the one link home announce itself twice.
 *
 * AND IT IS THE `ink` VARIANT HERE, WHICH IS NOT A DOWNGRADE. The canonical
 * mark is the pitch one and it belongs on the front door, where the wordmark is
 * the masthead. This bar is chrome: it wants a mark that behaves like the word
 * beside it, and `ink` fills its outer links with `currentColor`, so the whole
 * lockup sits at `ink.muted` at rest and lights up together on hover. The pitch
 * variant cannot do that — its links carry fixed tokens — so using it here
 * would bring back the exact "lockup lighting up in halves" the hover rule
 * below was written to prevent. It also reads better at this size, which is a
 * bonus rather than the reason.
 */
import { Mark } from "optfall-components/svelte";

interface Props {
  /** The nav item to mark as current, if any. */
  section?: "cards" | "sets" | "rules" | "syntax";
  /**
   * Whether the bar carries a search field.
   *
   * `false` on the two pages that render a search field of their own. The bar
   * exists so a second lookup does not cost a navigation — on a page that is
   * already a search field, it is the same control twice, sitting one above the
   * other, with the top one narrower and unlabelled. That reads as untidy at
   * 1440 and as a wasted row on a phone, where the bar wraps to two lines to
   * seat a field the page does not need.
   */
  field?: boolean;
}

const { section, field = true } = Astro.props;

/*
 * Five destinations, which is the whole site. A nav that needs a submenu is a
 * nav describing a product with more surfaces than this one has.
 *
 * `Syntax` is here rather than only linked from the search hint because the
 * grammar is the thing a reader needs at the moment they are already looking at
 * results and cannot narrow them — which is every page, not just the one with
 * the field on it. It is the most-linked page on the site this one is measured
 * against, for the same reason.
 */
const LINKS: readonly {
  href: string;
  label: string;
  key?: Props["section"];
}[] = [
  { href: "/search", label: "Cards", key: "cards" },
  { href: "/sets", label: "Sets", key: "sets" },
  { href: "/cr", label: "Rules", key: "rules" },
  { href: "/syntax", label: "Syntax", key: "syntax" },
  { href: "/random", label: "Random" },
];
---

<header class="bar">
  <a class="wordmark" href="/"><Mark size="sm" variant="ink" decorative />Optfall</a>

  <!--
    A real GET to the results page, so it works with scripting off and a
    submitted query lands on a shareable address. No island, no index.
  -->
  {
    field && (
      <form class="find" role="search" aria-label="Flesh and Blood cards" action="/search" method="get">
        <label class="sr" for="site-search">Search the cards</label>
        <input
          id="site-search"
          class="field"
          name="q"
          type="search"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          placeholder="Search cards"
        />
      </form>
    )
  }

  <nav class="links" aria-label="Sections">
    {
      LINKS.map((link) => (
        <a
          href={link.href}
          aria-current={link.key !== undefined && link.key === section ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--of-space-base) var(--of-space-loose);
    padding-block: var(--of-space-base);
    margin-block-end: var(--of-space-loosest);
    border-block-end: var(--of-ornament-rule-width) solid var(--of-color-rule);
  }

  .wordmark {
    /* A lockup, not a line of text: the mark and the name sit on one baseline
       with the tracking already in the type, so the gap has to come from the
       box rather than from a space character. */
    display: inline-flex;
    align-items: center;
    gap: var(--of-space-tight);
    font-size: var(--of-type-size-small);
    font-weight: var(--of-type-weight-medium);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
    text-decoration: none;
    flex: 0 0 auto;
  }

  /* The `ink` variant fills its outer links with `currentColor`, so they take
     the muted ink of the resting bar and the full ink on hover along with the
     word — one object lighting up rather than a logo beside a link that
     changed. That inheritance is load-bearing for this rule, which is why the
     mark above is `variant="ink"`: the canonical pitch variant carries fixed
     tokens, and using it here would put the lockup back to lighting up in
     halves, with a bright chain against a muted word at rest. */
  .wordmark:hover {
    color: var(--of-color-ink);
  }

  /* Takes the middle and gives it back when the bar wraps on a narrow screen. */
  .find {
    flex: 1 1 var(--of-card-face-thumb);
    min-inline-size: 0;
  }

  .field {
    inline-size: 100%;
    padding: var(--of-space-tighter) var(--of-space-tight);
    border: var(--of-bevel-width) solid var(--of-color-rule);
    border-radius: var(--of-bevel-radius);
    background: var(--of-color-sunken);
    color: var(--of-color-ink);
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-small);
  }

  .field::placeholder {
    color: var(--of-color-ink-faint);
  }

  .field:focus {
    outline: calc(var(--of-bevel-width) * 2) solid var(--of-color-focus);
    outline-offset: var(--of-space-tightest);
  }

  .field::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .links {
    display: flex;
    gap: var(--of-space-loose);
    flex: 0 0 auto;
    font-size: var(--of-type-size-small);
  }

  .links a {
    color: var(--of-color-ink-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--of-color-ink);
  }

  /* The current section is marked by ink and a rule, never by colour alone. */
  .links a[aria-current="page"] {
    color: var(--of-color-ink);
    box-shadow: inset 0 calc(-1 * var(--of-bevel-width)) 0 0 var(--of-color-accent);
  }

  /* Visible to a screen reader, not on screen: the placeholder is not a label,
     and a field whose only name is its placeholder loses that name the moment
     somebody types into it. */
  .sr {
    position: absolute;
    inline-size: var(--of-space-hair);
    block-size: var(--of-space-hair);
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
