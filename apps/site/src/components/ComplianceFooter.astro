---
// COMPLIANCE COMPONENT — read before editing.
//
// Legend Story Studios' Terms of Use for Game and Studio Assets and IP grant
// third-party applications like this one a written permission, on conditions.
// Two of those conditions live in this file:
//
//   1. The disclaimer must appear verbatim, in the footer, on every page. The
//      text is not written here — it comes from the single exported constant
//      required by docs/COMPLIANCE.md, so there is exactly one place a typo
//      can live. Render it as one text node; never split it across elements
//      and never reflow it.
//
//   2. No Flesh and Blood or Legend Story Studios logos or set symbols may
//      appear anywhere on the site — product set logos count as FAB logos.
//      Nothing in this footer is a mark, and nothing here should become one.
//
// Presentation now comes from the token layer, as Phase 1 said it would. The
// *text* is still not Phase 1's to change, and is not changed here.
import { LSS_DISCLAIMER } from "../lib/compliance";
---

<footer class="compliance">
  <p class="disclaimer">{LSS_DISCLAIMER}</p>
  <p class="licence">
    Optfall's own code is MIT-licensed. Published datasets are openly licensed
    only over the structural work this project owns — rule identifiers, the
    legality timeline, diffs and annotations. <a href="/data-terms">Data terms</a>.
  </p>
</footer>

<style>
  /* A hairline rule, not a box. `docs/DESIGN.md`: density is held together by
     tight vertical rhythm and hairline rules rather than cards and shadows. */
  .compliance {
    margin-block-start: var(--of-space-loosest);
    padding-block-start: var(--of-space-looser);
    border-block-start: var(--of-ornament-rule-width) solid var(--of-color-rule);
    color: var(--of-color-ink-faint);
    font-size: var(--of-type-size-micro);
    line-height: var(--of-type-leading-loose);
  }

  /* Muted by token rather than by `opacity`. Opacity would dim the text
     against whatever sits behind it, which makes the contrast unknowable —
     and `color.ink.faint` is a value the theme's own tests assert against the
     ground at the large-text threshold. */
  .compliance p {
    margin-block: 0 var(--of-space-base);
  }

  .compliance p:last-child {
    margin-block-end: 0;
  }
</style>
