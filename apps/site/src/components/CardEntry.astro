---
/**
 * One card, in full — the body of `/card/<slug>`, and the thing `docs/PLAN.md`
 * Phase 2 says people arrive for.
 *
 * "Every view is a URL. `/card/command-and-conquer` … is the product, not
 * decoration on it." So this page is built to be *pasted*: the name is the
 * heading, the legality is dated and evidenced, and everything on it is either
 * a value read off the upstream record or a fixed label wrapped around one.
 *
 * SIX DECISIONS, EACH OF WHICH A REVIEWER SHOULD BE ABLE TO ARGUE WITH.
 *
 * **THE VERDICT IS A LIST OF PILLS, NEVER A SINGLE WORD, AND IT IS NEVER
 * `cc_legal`.** `apps/site/src/lib/cards.ts` derives it; this page only prints
 * what it derived. The distinction matters because upstream's `cc_legal` means
 * "in the Classic Constructed card pool" and is `true` on all 51 `cc_banned`
 * cards — rendering that flag as a Legal pill is precisely the incumbent bug
 * `docs/PLAN.md` Phase 3 cites as the reason this project exists. One card
 * (Winter's Wail) is `cc_banned` *and* `cc_living_legend`, so both pills render.
 *
 * **EVERY VERDICT SHIPS ITS EVIDENCE, AND AN UNUSUAL ONE SHOWS IT UNASKED.**
 * The raw upstream keys sit beneath the pills in the mono voice, with an absent
 * key shown as `—` rather than as `false`. `docs/PLAN.md`: the tool is
 * "auditable rather than merely assertive, which is what matters when the
 * commercially-backed incumbent ships incorrect flags."
 *
 * This comment used to end "it is not behind a disclosure widget, because a
 * claim whose evidence needs a click is a claim being asserted", and the
 * evidence is now behind one — so the sentence is corrected rather than left to
 * contradict the code beneath it. The argument it made is not abandoned: see
 * {@link evidenceOpen}, where `open` is computed rather than chosen. Any verdict
 * carrying a real exclusion — banned, suspended, restricted, Living Legend —
 * arrives already open. What folds is the verdict nobody would dispute.
 *
 * **THE PAGE MAKES NO HISTORICAL CLAIM.** Every legality sentence here is
 * present-tense and stamped with the date the corpus was confirmed. `since`
 * dates are printed where upstream publishes one and are labelled as the start
 * of the *current* state, never as a history. Legality as of a date is Phase 3
 * and is named as absent rather than implied.
 *
 * **THE STAT BLOCK IS A `<dl>`.** Cost, Power, Defence, Life, Intellect and
 * Arcane are term-and-value data, so they are marked up as term-and-value data
 * rather than as a row of styled `<div>`s. A card with no power has no Power
 * row at all — and 13 cards genuinely have `power: "0"`, which is a different
 * fact and gets a row saying `0`.
 *
 * **EVERY LINK TO ANOTHER CARD RENDERS `link.label`, NEVER `link.name`.** 900
 * names in this corpus belong to two to four different cards, so a list of
 * anchors reading "Head Jab", "Head Jab", "Head Jab" pointing at three URLs is
 * both useless and a WCAG 2.4.4 failure. The label carries the variant suffix
 * and is composed once, in `cards.ts`, so a page cannot forget it.
 *
 * **THE FACE IS THE FIRST THING, AND IT ARRIVES THROUGH A PRIMITIVE.** This
 * comment used to say the opposite — that no face was rendered, deliberately,
 * because card images are permitted only on the condition that a copyright line
 * accompanies them and the primitive designed to make that condition
 * unrepresentable-if-missing did not exist yet. It exists now. `CardFace` emits
 * `CARD_IMAGE_COPYRIGHT` itself on every render, with no prop and no variant
 * that can drop it, so the condition is satisfied by construction rather than by
 * this page remembering. The printings table still cites collector number, set
 * and artist, because that is the citable identity of a printing and a picture
 * is not a citation.
 *
 * **THE RAIL SHOWS ONLY PRINTINGS THAT HAVE ART.** A card averages 3.3
 * printings and several list a cold-foil variant upstream does not publish a
 * face for. A row of NO IMAGE tiles would be a worse artefact than a shorter
 * rail, and the table below still lists every printing, so nothing is hidden.
 *
 * Everything visible is composed from `optfall-components`. The styles below
 * are layout and voice assignment only, and every value in them is a
 * `var(--of-*)`; `bun run check:tokens` fails the build otherwise.
 */
import {
  BevelledPlate,
  CardFace,
  OrnamentalRule,
  GameSymbol,
  PitchJewel,
  StatGlyph,
  StatePill,
} from "optfall-components/svelte";

import PrintingPicker from "./PrintingPicker.svelte";
import PrintedText from "./PrintedText.astro";
import { symbolForKind, type SymbolKind } from "../lib/card-symbols";

import {
  CORPUS,
  LAST_CONFIRMED,
  hrefForSlug,
  type CardLink,
  type CardPage,
} from "../lib/cards";
import corpusJson from "../../../../data/rules/cr-2.14.0.json";
import { buildKeywordVocabulary, rulesForCard } from "../lib/keywords";
import { hrefForNumber, type RulesCorpus } from "../lib/search";
import {
  editionName,
  foilingName,
  hrefForSet,
  rarityName,
  setName,
} from "../lib/sets";
import {
  boxFor,
  faceKeyFor,
  faceUrl,
  orientationOf,
  placeholderUrl,
} from "../lib/faces";

interface Props {
  page: CardPage;
}

const { page } = Astro.props;
const { card } = page;

const typeLine = card.type_text.trim();
const text = card.functional_text.trim();

/**
 * Lists upstream publishes per card, rendered only where non-empty.
 *
 * Read off the record and labelled, never summarised. `traits` is populated on
 * 9 cards and `removed_keywords` on 12 — printing an empty "Traits: none" row
 * on the other 4,932 would be noise dressed as completeness.
 */
const vocabularies: readonly (readonly [string, readonly string[]])[] = [
  ["Types", card.types],
  ["Traits", card.traits],
  ["Keywords", card.card_keywords],
  ["Abilities and effects", card.abilities_and_effects],
  ["Ability keywords", card.ability_and_effect_keywords],
  ["Grants", card.granted_keywords],
  ["Removes", card.removed_keywords],
  ["Interacts with", card.interacts_with_keywords],
];
const vocabulary = vocabularies.filter(([, values]) => values.length > 0);

/**
 * Pitch leads the stat block rather than sitting only in the masthead jewel.
 *
 * The jewel is the reserved silhouette and carries pitch as shape, numeral and
 * colour; the `<dl>` is the tabular record, and a tabular record with a hole in
 * it where its most-read value should be is a worse artefact than a duplicated
 * one. Cards with no pitch get no row, exactly as they get no other absent stat.
 */
/**
 * Which glyph each printed stat takes, or `null` for pitch — the jewel owns
 * that one and its octagon is reserved to it.
 */
const GLYPH_FOR: Record<string, "cost" | "power" | "defence" | "life" | "intellect" | "arcane" | undefined> = {
  Cost: "cost",
  Power: "power",
  Defence: "defence",
  Life: "life",
  Intellect: "intellect",
  Arcane: "arcane",
};

/**
 * THE PRINTED SYMBOL FOR EACH STAT, so the stat block teaches the notation.
 *
 * A reader who meets `+1{p}` in the card text below should be able to look up
 * and see that Power is `{p}` — and after `card-symbols.ts` landed there is a
 * published table saying exactly that, so the row can carry the marker as fact
 * rather than as a hint.
 *
 * TWO ROWS DELIBERATELY GET NOTHING, and the gaps are the honest part:
 *
 *   - **Pitch** has no symbol in the rules. It has the jewel, which is the
 *     reserved silhouette and already says pitch three ways.
 *   - **Arcane** has no symbol either. CR 1.12.4 names eight and arcane is not
 *     among them, so the row shows its plate and no marker. Inventing `{a}` to
 *     make the column tidy is the exact move this file spent several phases
 *     refusing to make about `{p}`.
 *
 * Cost maps to the RESOURCE symbol, which is not a fudge: CR 1.12.4e makes
 * `{r}` a resource value, and a cost is the resource value you pay. They share
 * the hexagonal plate for the same reason.
 */
const SYMBOL_FOR: Record<string, SymbolKind | undefined> = {
  Cost: "resource",
  Power: "power",
  Defence: "defence",
  Life: "life",
  Intellect: "intellect",
};

const stats = (page.pitch === 0
  ? page.stats
  : [{ label: "Pitch", value: String(page.pitch) }, ...page.stats]
).map((stat) => {
  const kind = SYMBOL_FOR[stat.label];
  return {
    label: stat.label,
    value: stat.value,
    kind: GLYPH_FOR[stat.label] ?? null,
    symbol: kind === undefined ? null : symbolForKind(kind),
  };
});

const nameHref = hrefForSlug(page.nameSlug);

/** Related-card lists, in the order they answer a question about this card. */
const related: readonly (readonly [string, string, readonly CardLink[]])[] = [
  ["Other versions", "Same name, different pitch.", page.variants],
  ["Names these cards", "Cards this card's text refers to by name.", page.references],
  ["Named by", "Cards whose text refers to this one by name.", page.referencedBy],
];
const relatedShown = related.filter(([, , links]) => links.length > 0);

const printingCount = card.printings.length;

/* -------------------------------------------------------------------------- */
/* The rules that govern this card                                             */
/* -------------------------------------------------------------------------- */

/**
 * THE JOIN NOTHING ELSE IN THE GAME MAKES. `docs/PLAN.md` Phase 4 lists
 * "Card ↔ rules cross-reference" as a deliverable; this is it, on the surface
 * that needs it.
 *
 * Both sides are published documents and the join is exact matching over a
 * closed vocabulary the Comprehensive Rules itself defines — see `lib/keywords`
 * for the extraction and for why this survives the no-language-model rule. A
 * keyword either cites a rule the document names, or it appears without one.
 * Nothing here guesses at the nearest paragraph.
 *
 * Built at build time from the committed corpus; the 651 KB of rules text never
 * reaches a browser, only the identifiers do.
 */
const keywordRules = rulesForCard(
  buildKeywordVocabulary(corpusJson as unknown as RulesCorpus),
  [...card.card_keywords, ...card.ability_and_effect_keywords],
);

/* -------------------------------------------------------------------------- */
/* The face                                                                    */
/* -------------------------------------------------------------------------- */

/**
 * The accessible name for the card's picture.
 *
 * FIXED LABELS AROUND VERBATIM VALUES, exactly as `titleFor` and
 * `descriptionFor` in `lib/cards.ts` are built — the card's own label and its
 * own printed type line, joined by an em dash this file supplies. Nothing here
 * describes the artwork, because Optfall has no way to know what is in it and a
 * generated description of a picture is precisely the composed prose the
 * project rules out. A reader who cannot see the image gets the card's identity,
 * which is what the image is doing on the page.
 */
const faceAlt = typeLine === "" ? page.label : `${page.label} — ${typeLine}`;

const faceBox = boxFor("normal", page.face.orientation);
const faceSrc =
  page.face.key === null
    ? placeholderUrl(page.face.orientation)
    : faceUrl(page.face.key, "normal");

/**
 * Every printing that publishes art, as a rail beneath the face.
 *
 * `docs/SCRYFALL-GAP.md` §5.1c: the printing is the addressable unit, and a
 * card averaging 3.3 of them should show them rather than list their codes in a
 * table. Printings with no published art are deliberately absent from the rail
 * — a row of NO IMAGE tiles would be a worse artefact than a shorter rail, and
 * the printings TABLE below still lists every one of them, so nothing is hidden.
 */
/**
 * Every distinct printing, for the picker.
 *
 * Named by SET and number rather than by number alone: `BEN010` answers "which
 * printing" for somebody who already knows the set codes and for nobody else.
 * Deduplicated by face, because foiling variants share one image and two
 * identical tiles say nothing twice.
 */
const printings = (() => {
  const seen = new Set<string>();
  const entries: {
    key: string;
    id: string;
    edition: string;
    setName: string;
    setCode: string;
    thumb: string;
    normal: string;
    width: number;
    height: number;
    thumbWidth: number;
    thumbHeight: number;
  }[] = [];

  for (const printing of card.printings) {
    const key = faceKeyFor(printing.image_url);
    if (key === null || seen.has(key)) continue;
    seen.add(key);

    const orientation = orientationOf({
      playedHorizontally: card.played_horizontally,
      rotationDegrees: printing.image_rotation_degrees,
    });
    const normalBox = boxFor("normal", orientation);
    const thumbBox = boxFor("thumb", orientation);

    entries.push({
      key,
      id: printing.id,
      edition: printing.edition,
      setName: setName(printing.set_id),
      setCode: printing.set_id,
      thumb: faceUrl(key, "thumb"),
      normal: faceUrl(key, "normal"),
      width: normalBox.width,
      height: normalBox.height,
      thumbWidth: thumbBox.width,
      thumbHeight: thumbBox.height,
    });
  }

  /*
    DISAMBIGUATED ONLY WHERE IT IS NEEDED. Set and collector number identify a
    printing almost always — but not always: Head Jab's Welcome to Rathe entry
    is Alpha AND Unlimited, two different pieces of art under one number, and
    labelling both "Welcome to Rathe · WTR098" is exactly the useless repetition
    naming them by set was meant to fix. The edition is appended only to the
    groups that collide, so an ordinary tile stays a set and a number.
  */
  const perNumber = new Map<string, number>();
  for (const entry of entries) {
    const key = `${entry.setCode}/${entry.id}`;
    perNumber.set(key, (perNumber.get(key) ?? 0) + 1);
  }

  for (const entry of entries) {
    if ((perNumber.get(`${entry.setCode}/${entry.id}`) ?? 0) > 1) {
      entry.id = `${entry.id} · ${editionName(entry.edition)}`;
    }
  }

  return entries;
})();

/**
 * The card still needs a face when no printing publishes art — four printings
 * in the corpus, and the picker has nothing to show for them.
 */
const facelessBox = boxFor("normal", page.face.orientation);

/**
 * Shown only when there is a choice to make. One printing is not a rail, it is
 * the same picture again.
 */

/* -------------------------------------------------------------------------- */
/* Pitch versions                                                              */
/* -------------------------------------------------------------------------- */

/**
 * The red, yellow and blue versions of a card, as tabs.
 *
 * A PLAYER CALLS THESE ONE CARD, AND THE DATASET CALLS THEM THREE. Upstream
 * gives each pitch version its own `unique_id`, its own printed text and its own
 * legality, because mechanically they are distinct — "Head Jab" red and "Head
 * Jab" blue do different things. But nobody at a table says "I'm playing the
 * pitch-2 Head Jab" as though naming a different card; they say Head Jab and
 * hold up a yellow one. So the versions belong on ONE page, switched, rather
 * than on three pages a reader has to find separately or on an index page that
 * makes them choose before showing them anything.
 *
 * THE TABS ARE REAL LINKS, NOT A SCRIPTED WIDGET, and that is the whole reason
 * this works on a static site. Each version keeps its own permanent URL, so a
 * tab is something you can paste; the switch works with scripting off; and there
 * is no state to lose. `docs/PLAN.md`: "Every view is a URL." A JavaScript tab
 * panel would have taken three addressable documents and made them one
 * unaddressable one, which is the opposite of what this project is for.
 *
 * The jewel carries the colour and the label carries the number, which is the
 * pitch contract from `docs/DESIGN.md` — the numeral is the primary channel and
 * colour is the redundant one, so a tab strip is legible to a reader who cannot
 * tell red from yellow. No colour NAMES are invented here: "Pitch 2" is the
 * vocabulary `variantSuffix` already uses in every link to a variant.
 */
/**
 * No-pitch sorts last, matching `byPitch` in `cards.ts`, so a card and its
 * token variant do not swap places between the tab strip and the URL scheme.
 *
 * At module scope because it captures nothing — the same rule
 * `unicorn(consistent-function-scoping)` enforces on `pitchRank` in `cards.ts`,
 * and for the same reason: a comparator that rebuilds a closure on every one of
 * its O(n log n) calls is what the rule exists to catch.
 */
function pitchRank(pitch: number): number {
  return pitch === 0 ? 4 : pitch;
}

const versions = [
  { pitch: page.pitch, href: page.href, current: true },
  ...page.variants.map((variant) => ({
    pitch: variant.pitch,
    href: variant.href,
    current: false,
  })),
].toSorted((a, b) => pitchRank(a.pitch) - pitchRank(b.pitch));

const showVersions = versions.length > 1;

/**
 * `?pitch=N`, as an ALIAS that navigates rather than a switch that renders.
 *
 * The asymmetry with `?printing=` is not an inconsistency, it is the difference
 * between the two things. Printings of one card differ ONLY by image, so one
 * document with a selection is exactly right. Pitch versions are different
 * cards — different printed text, different stats, different legality — and
 * each already has its own statically-rendered page at `/card/<name>-<pitch>`.
 *
 * Rendering `?pitch=2` in place would mean shipping every version's text,
 * stats, keywords and six format verdicts to every card page so a script could
 * swap them, and would leave a reader with scripting off, and every crawler,
 * looking at the wrong card. Navigating to the page that already exists costs
 * one redirect and keeps the static document canonical.
 *
 * So the param works — it is linkable, which is what was asked for — and it
 * resolves to the address that was already the answer.
 */
const pitchTargets = JSON.stringify(
  Object.fromEntries(versions.map((version) => [String(version.pitch), version.href])),
);

---

<nav class="lineage" aria-label="Breadcrumb">
  <ol class="crumbs">
    <li><a href="/">Optfall</a></li>
    <li><a href="/search">Cards</a></li>
    {
      page.disambiguated && (
        <li>
          <a href={nameHref}>{card.name}</a>
        </li>
      )
    }
    <li><span class="crumb-current" aria-current="page">{page.label}</span></li>
  </ol>
</nav>

<!--
  Inline because it is a redirect rather than a component: an island would ship
  a runtime to do what four lines of navigation do, and it has to run before the
  reader reads anything.
-->
<script is:inline define:vars={{ pitchTargets }}>
  {
    const wanted = new URLSearchParams(window.location.search).get("pitch");
    if (wanted !== null) {
      const target = JSON.parse(pitchTargets)[wanted];
      // Only when it names a DIFFERENT version — `?pitch=1` on the pitch-1 page
      // must not redirect to itself forever.
      if (target && target !== window.location.pathname.replace(/\/$/, "")) {
        const url = new URL(target, window.location.origin);
        // Everything else the reader asked for travels with them.
        for (const [key, value] of new URLSearchParams(window.location.search)) {
          if (key !== "pitch") url.searchParams.set(key, value);
        }
        window.location.replace(url.href);
      }
    }
  }
</script>

<article>
  <!--
    TWO COLUMNS, AND THE SPLIT IS THE REDESIGN.

    `docs/SCRYFALL-GAP.md` §6a: everything answering "what is this card" lands
    above the fold, and the apparatus — printings, flavour, related, source —
    goes below it. Before this, the face was followed by eight stacked sections
    and you scrolled past three of them to reach the legality verdict, which is
    the best thing on the page and most of the reason the project exists.

    It collapses to one column under a narrow viewport, where side-by-side would
    make the face too small to read a stat line off.
  -->
  <div class="identity">
    <div class="identity-face">
      <!--
        THE PICKER IS AN ISLAND, and it is the only one on this page. §5.2 rules
        out live updating for SEARCH — results must not re-rank under a cursor,
        because the URL is the product. A printing picker is the opposite case:
        it changes which image is shown and nothing else. No query, no ranking,
        nothing a reader would want to paste that the card's own URL does not
        already carry.
      -->
      {
        printings.length > 0 ? (
          <PrintingPicker
            printings={printings}
            alt={faceAlt}
            label={page.label}
            client:load
          />
        ) : (
          <CardFace
            src={placeholderUrl(page.face.orientation)}
            alt={faceAlt}
            width={facelessBox.width}
            height={facelessBox.height}
            loading="eager"
          />
        )
      }
    </div>

    <div class="identity-facts">
      <header class="masthead">
        <p class="eyebrow">{typeLine === "" ? "Flesh and Blood card" : typeLine}</p>
        <div class="title-row">
          <PitchJewel value={page.pitch} size="lg" />
          <!--
            THE BARE NAME, NOT THE DISAMBIGUATED LABEL. Everywhere else in the
            product a link to this card renders `page.label` — "Head Jab (pitch
            2)" — because 900 names belong to more than one card and two anchors
            that differ only in where they point are a WCAG 2.4.4 failure. Here
            the tab strip immediately below carries that distinction, and
            visibly, so repeating it in the heading would say the same thing
            twice and make the three versions read as three cards.
          -->
          <h1 class="card-name">{card.name}</h1>
        </div>
      </header>

      {
        showVersions && (
          <nav class="versions" aria-label={`Pitch versions of ${card.name}`}>
            <ul class="version-tabs">
              {versions.map((version) => (
                <li>
                  {version.current ? (
                    /*
                      The current tab is not a link. An anchor pointing at the
                      page you are already on is a control that does nothing,
                      and `aria-current` on a link still leaves it in the tab
                      order as a dead end.
                    */
                    <span class="version-tab current" aria-current="page">
                      <PitchJewel value={version.pitch} size="sm" />
                      <span class="version-label">
                        {version.pitch === 0 ? "No pitch" : `Pitch ${version.pitch}`}
                      </span>
                    </span>
                  ) : (
                    <a class="version-tab" href={version.href}>
                      <PitchJewel value={version.pitch} size="sm" />
                      <span class="version-label">
                        {version.pitch === 0 ? "No pitch" : `Pitch ${version.pitch}`}
                      </span>
                    </a>
                  )}
                </li>
              ))}
            </ul>
            <p class="versions-note">
              Same name, different card — its own text, stats and legality. Each tab is a permanent URL, and <code>?pitch=2</code> resolves to one.
            </p>
          </nav>
        )
      }

      <!--
        THE STAT BLOCK STAYS A DEFINITION LIST AND STOPS LOOKING LIKE A TABLE.

        An earlier note here argued the semantics and was right: cost, power and
        defence are term-and-value data, and marking them up as anything else
        would be a lie for a layout's sake. What was wrong was the RENDERING — a
        stacked grid restating in rows what the face beside it now shows at a
        glance. So the markup is unchanged and the CSS makes it a compact strip,
        which is the card's own furniture rather than a table of it. 13 cards
        genuinely have a printed power of 0 and still get a row saying 0.
      -->
      <section class="apparatus" aria-labelledby="stats">
        <h2 class="apparatus-heading" id="stats">Stats</h2>
        {
          stats.length === 0 ? (
            <p class="void">This card carries no printed cost, power, defence, life, intellect or arcane value.</p>
          ) : (
            <dl class="stats">
              {stats.map((stat) => (
                <div class="stat">
                  <dt>
                    {stat.label}
                    {/*
                      The printed marker, beside the word it names. This is what
                      connects the stat block to the card text below it: a
                      reader who sees the power plate here recognises the same
                      plate in `+1{p}`, and the pair is the whole reason
                      `GameSymbol` and `StatGlyph` share a shape table.

                      `aria-hidden`, because the label already says "Power" and
                      a screen reader announcing "Power power" is worse than
                      one announcing "Power".
                    */}
                    {stat.symbol !== null && (
                      <span class="stat-symbol" aria-hidden="true">
                        <GameSymbol
                          kind={stat.symbol.kind}
                          letter={stat.symbol.letter}
                          name={stat.symbol.name}
                        />
                      </span>
                    )}
                  </dt>
                  <dd>
                    {/*
                      THE SHAPE SAYS WHICH STAT IT IS, as docs/DESIGN.md always
                      described the card face — cost in a hexagonal plate,
                      power and defence in chamfered ones. The numeral stays the
                      primary channel and the label stays visible, so the
                      silhouette is the third redundant carrier rather than the
                      only one.
                    */}
                    {stat.kind === null ? (
                      stat.value
                    ) : (
                      <StatGlyph kind={stat.kind} value={stat.value} />
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </section>

      <section class="apparatus" aria-labelledby="printed-text">
        <h2 class="apparatus-heading" id="printed-text">Printed text</h2>
        {
          text === "" ? (
            <p class="void">This card has no rules text in the published dataset.</p>
          ) : (
            <PrintedText text={card.functional_text} uid={page.slug} />
          )
        }
        <!--
          REPRODUCED *AND* INTERPRETED, WITH BOTH ON THE PAGE.

          This note used to say the opposite: "Optfall has no published table
          mapping those markers to words — so substituting any would be
          inventing a vocabulary and calling it the card's text." The premise
          was true of the card corpus and false of this repository. The
          Comprehensive Rules — already committed, already parsed, already what
          every keyword on this page cites — defines all of them at 1.12.4a–h.

          So rendering them is not an interpretation, it is the same join this
          site already makes between a keyword and its rule. "Raw text" keeps
          upstream's bytes one click away, because a join is a claim and a
          reference work should let you check it.
        -->
        <p class="verify">Verbatim in both views. “Text” renders upstream’s own <code>**</code> and <code>&#123;…&#125;</code> markers using the rules’ own symbol table; “Raw text” is the published bytes, unaltered.</p>
      </section>

      {
        keywordRules.length > 0 && (
          <section class="apparatus" aria-labelledby="governed-by">
            <h2 class="apparatus-heading" id="governed-by">Governed by</h2>
            <ul class="rules-list">
              {keywordRules.map((rule) => (
                <li class="rules-item">
                  <a class="rules-citation" href={hrefForNumber(rule.number)}>{rule.ruleId}</a>
                  <span class="rules-keyword">{rule.keyword}</span>
                  {rule.via === "family" && (
                    /*
                      SAID OUT LOUD, because it is a slightly weaker claim. The
                      rules define `Specialization` once and cards instantiate
                      it per hero, so "Briar Specialization is governed by the
                      Specialization rule" is true but is a resolution rather
                      than a direct hit — and a reference work should say which
                      kind of claim it is making.
                    */
                    <span class="rules-via">via the general rule</span>
                  )}
                </li>
              ))}
            </ul>
            <p class="verify">Matched exactly against the vocabulary the rules publish. A keyword the document does not define is absent rather than guessed at.</p>
          </section>
        )
      }

      <!--
        LEGALITY MOVES UP, INTO THE FOLD. It used to sit below the article,
        after stats, text and attributes — the fourth thing on the page. It is
        the differentiator: a verdict that is a LIST of states, each with the
        upstream flags it was derived from.
      -->
      <section class="apparatus" aria-labelledby="legality">
        <h2 class="apparatus-heading" id="legality">Legality</h2>

        <!--
          The scope of the claim, stated before the claim. Inline elements stay
          on the same source line as the text around them: the build drops the
          whitespace at a line break falling immediately before an inline tag,
          welding words together in the output.
        -->
        <p class="scope">
          Present day only, confirmed <time datetime={LAST_CONFIRMED}>{LAST_CONFIRMED}</time>. A <em>since</em> date is when the current state began — not a history.
        </p>

        <ul class="formats">
          {
            page.verdicts.map((verdict) => (
              <li class="format">
                <h3 class="format-name" id={`format-${verdict.format.id}`}>
                  {verdict.format.name}
                </h3>

                {verdict.unknown ? (
                  <p class="void">
                    The dataset publishes no legality flag for this format, so Optfall
                    has nothing to say about this card in it. It publishes only
                    exclusions here, and none is set on this card.
                  </p>
                ) : (
                  <ul class="states">
                    {verdict.states.map((state) => (
                      <li class="state">
                        <StatePill tone={state.tone} label={state.label} />
                        {state.since !== null && (
                          <span class="since">
                            since <time datetime={state.since}>{state.since}</time>
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                )}

                {verdict.affectsFullCycle && verdict.format.id === "living-legend" && (
                  <p class="scope">Upstream records this restriction as affecting the full cycle of cards sharing this name.</p>
                )}

                {/*
                  THE UPSTREAM FLAGS ARE NO LONGER RENDERED, and the argument
                  for them is worth recording rather than deleting.

                  They existed for auditability: "the tool is auditable rather
                  than merely assertive, which is what matters when the
                  commercially-backed incumbent ships incorrect flags". That
                  still matters. What changed is the observation that the row
                  was saying what the pills already said — `ll_banned: true`
                  beside a pill reading Banned, `ll_banned_start: 2024-07-08`
                  beside "since 2024-07-08" — in upstream's key names rather
                  than in words. It was a second rendering of the verdict, not
                  evidence for it.

                  Auditability moves to where PLAN.md already puts it: "Publish
                  the data, not just the site." The full flag set ships in the
                  openly-licensed corpus, which is the artefact a second tool
                  would check us against — and a reader who wants to see the
                  derivation reads the export rather than 36 rows of dashes.
                */}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  {
    vocabulary.length > 0 && (
      <section class="apparatus" aria-labelledby="attributes">
        <h2 class="apparatus-heading" id="attributes">Attributes</h2>
        <dl class="attributes">
          {vocabulary.map(([label, values]) => (
            <div class="attribute">
              <dt>{label}</dt>
              <dd>
                <ul class="tags">
                  {values.map((value) => (
                    <li class="tag">{value}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
          {card.played_horizontally && (
            <div class="attribute">
              <dt>Orientation</dt>
              <dd>Played horizontally</dd>
            </div>
          )}
        </dl>
      </section>
    )
  }
</article>

<OrnamentalRule label="Printings" />

<section class="apparatus" aria-labelledby="printings">
  <h2 class="apparatus-heading" id="printings">Printings</h2>
  <p class="scope">
    {printingCount} printing{printingCount === 1 ? "" : "s"}. The collector number
    is the citable identity of a printing. Set, edition, foiling and rarity are
    upstream's own single-letter codes, reproduced rather than expanded — Optfall
    publishes no table mapping them to words, and inventing one would be a claim
    rather than a lookup. No card face is shown: images are permitted with a
    copyright line, and the component that carries that line unconditionally is
    not built yet.
  </p>

  <div class="scroller">
    <table class="printings">
      <caption class="visually-hidden">Every published printing of {page.label}</caption>
      <thead>
        <tr>
          <th scope="col">Number</th>
          <th scope="col">Set</th>
          <th scope="col">Rarity</th>
          <th scope="col">Edition</th>
          <th scope="col">Foiling</th>
          <th scope="col">Artist</th>
          <th scope="col">Other face</th>
        </tr>
      </thead>
      <tbody>
        {
          page.printings.map(({ printing, otherFace }) => (
            <tr>
              <th scope="row" class="collector">{printing.id}</th>
              {/*
                IN WORDS, WITH THE CODE KEPT BESIDE IT. Until now this table
                printed upstream's storage letters — R, N, S — which is a
                database dump rather than a reference work. The name is what a
                reader wants; the code is what a printing is CITED by, so both
                are here and the code stays in the mono voice that means
                citable. An unknown code falls back to itself rather than to a
                blank, so a set Optfall has not re-synced reads as unnamed
                rather than as missing.
              */}
              <td>
                <a href={hrefForSet(printing.set_id)}>{setName(printing.set_id)}</a>
                <span class="code-hint">{printing.set_id}</span>
              </td>
              <td>{printing.rarity === "" ? "—" : rarityName(printing.rarity)}</td>
              <td>{printing.edition === "" ? "—" : editionName(printing.edition)}</td>
              <td>{printing.foiling === "" ? "—" : foilingName(printing.foiling)}</td>
              <td>{printing.artists.length === 0 ? "—" : printing.artists.join(", ")}</td>
              <td>
                {otherFace === null ? (
                  "—"
                ) : (
                  <a href={otherFace.href}>{otherFace.label}</a>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    page.printings.some(({ printing }) => printing.flavor_text.trim() !== "") && (
      <div class="flavour">
        <h3 class="apparatus-heading" id="flavour">Flavour text</h3>
        <dl class="attributes">
          {page.printings
            .filter(({ printing }) => printing.flavor_text.trim() !== "")
            .map(({ printing }) => (
              <div class="attribute">
                <dt class="collector">{printing.id}</dt>
                <dd class="flavour-text">{printing.flavor_text}</dd>
              </div>
            ))}
        </dl>
      </div>
    )
  }
</section>

{
  relatedShown.length > 0 && (
    <>
      <OrnamentalRule label="Related cards" />
      <section class="apparatus" aria-labelledby="related">
        <h2 class="apparatus-heading" id="related">Related cards</h2>
        {relatedShown.map(([label, blurb, links]) => (
          <div class="related">
            <h3 class="related-name">{label}</h3>
            <p class="scope">{blurb}</p>
            <ul class="links">
              {links.map((link) => (
                <li class="link">
                  <PitchJewel value={link.pitch} size="sm" />
                  {/*
                    `link.label`, never `link.name`. Two cards on this list can
                    share a name; the label is what makes the two anchors
                    distinguishable to somebody reading the links alone.
                  */}
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    </>
  )
}

<OrnamentalRule label="Source" />

<section class="apparatus" aria-labelledby="source">
  <h2 class="apparatus-heading" id="source">Source</h2>
  <BevelledPlate emphasis="sunken">
    <dl class="provenance">
      <dt>Upstream</dt>
      <dd><a class="source-url" href={`https://github.com/${CORPUS.source.repository}`}>{CORPUS.source.repository}</a></dd>

      <dt>File</dt>
      <dd><code>{CORPUS.source.path}</code></dd>

      <dt>Pinned commit</dt>
      <dd><code class="hash">{CORPUS.source.commit}</code></dd>

      <dt>Last confirmed</dt>
      <dd><time datetime={LAST_CONFIRMED}>{LAST_CONFIRMED}</time></dd>

      <dt>Retrieved from</dt>
      <dd><a class="source-url" href={CORPUS.source.url}>{CORPUS.source.url}</a></dd>

      <dt>File SHA-256</dt>
      <dd><code class="hash">{CORPUS.source.sha256}</code></dd>

      <dt>This card</dt>
      <dd><code>{card.unique_id}</code></dd>
    </dl>
  </BevelledPlate>
  <p class="verify">Card {page.ordinal} of {CORPUS.counts.cards}. Fetch that URL, hash it, compare. Every value here is read from those bytes by deterministic code — no language model touches this corpus.</p>
  <p class="legal">{CORPUS.rights}</p>
</section>

<style>
  /* -- The face and its printings rail ------------------------------------- */

  /*
    Layout only. `CardFace` owns everything about how a face is drawn, including
    the copyright line it will not let a caller omit; this places it and nothing
    more.
  */
  /*
    THE TWO-COLUMN FOLD, WITH NO BREAKPOINT — and that is deliberate rather
    than clever. There is not one width media query anywhere else in this
    repository: the system holds pages together with intrinsic sizing, and a
    chosen pixel width would be the first arbitrary number in a codebase whose
    lint rule exists to keep arbitrary numbers out. `check:tokens` refuses a raw
    length here, which is the rule doing its job.

    So the columns wrap when they stop fitting rather than when a designer
    guessed they would. The face keeps its natural width; the facts column
    asks for one face-width of room and takes any surplus. When the viewport
    cannot seat both, the basis is unsatisfiable and the facts wrap beneath —
    which is the real condition ("the face and the text no longer fit side by
    side") expressed directly instead of approximated by a breakpoint.
  */
  .identity {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--of-space-loosest);
  }

  .identity-face {
    display: flex;
    flex-direction: column;
    gap: var(--of-space-base);
    /* Never grows, never shrinks below the face: it is a fixed-size object
       beside a text column, not a banner. */
    flex: 0 0 auto;
    max-inline-size: 100%;
  }

  /*
    NO `position: sticky` ON THE FACE, and it was tried. Following the reader
    down the legality list is genuinely nice on a wide screen — and the same
    declaration, once the columns have wrapped, pins the face to the top of a
    phone screen and scrolls the entire card underneath it. Turning it off for
    the wrapped case needs the breakpoint this layout exists to avoid, and a
    behaviour that is pleasant on a desktop and hostile on a phone is not worth
    a media query's worth of arbitrary number.
  */
  .identity-facts {
    /* One face-width of preferred room, free to take the surplus, free to
       wrap. `min-inline-size: 0` because a flex item's default `auto` minimum
       refuses to shrink below its content, which a long card name would
       otherwise use to force a horizontal scroll. */
    flex: 1 1 var(--of-card-face-normal);
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: var(--of-space-looser);
  }

  /* -- The evidence disclosure --------------------------------------------- */

  /*
    Open on anything other than a plain Legal verdict — see `evidenceOpen` in
    the frontmatter for why that rule, rather than a preference, is what lets
    this fold at all.
  */
  .evidence-fold {
    margin-block-start: var(--of-space-tight);
  }

  .evidence-summary {
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
    color: var(--of-color-ink-faint);
    cursor: pointer;
  }

  .evidence-summary:hover {
    color: var(--of-color-ink-muted);
  }

  /* The marker is the only disclosure affordance in the system, so it is left
     to the platform rather than redrawn — a custom triangle here would be a
     control the component library does not own. */
  .evidence-fold[open] .evidence-summary {
    margin-block-end: var(--of-space-tight);
  }

  .code-hint {
    margin-inline-start: var(--of-space-tight);
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-wide);
    color: var(--of-color-ink-faint);
  }

  /* -- Governed by ---------------------------------------------------------- */

  .rules-list {
    display: flex;
    flex-direction: column;
    gap: var(--of-space-tight);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rules-item {
    display: flex;
    align-items: baseline;
    gap: var(--of-space-base);
    flex-wrap: wrap;
  }

  /* Monospaced, because in this system that means you can paste it into an
     argument — which is the entire point of a citation. */
  .rules-citation {
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-small);
    letter-spacing: var(--of-type-tracking-wide);
    color: var(--of-color-accent);
  }

  .rules-keyword {
    font-family: var(--of-type-family-serif);
    font-size: var(--of-type-size-base);
    text-transform: capitalize;
  }

  .rules-via {
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
    color: var(--of-color-ink-faint);
  }

  /* -- Pitch version tabs --------------------------------------------------- */

  .versions {
    display: flex;
    flex-direction: column;
    gap: var(--of-space-tight);
  }

  .version-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--of-space-tight);
    margin: 0;
    padding: 0;
    list-style: none;
    /* The strip sits on a rule rather than in a box: the system separates
       regions with hairlines, and a tab row is a region boundary by nature. */
    border-block-end: var(--of-ornament-rule-width) solid var(--of-color-rule);
  }

  .version-tab {
    display: inline-flex;
    align-items: center;
    gap: var(--of-space-tight);
    padding: var(--of-space-tight) var(--of-space-base);
    text-decoration: none;
    color: var(--of-color-ink-muted);
    /* Square, never rounded — stated rather than omitted, so a host stylesheet
       cannot round the one control this page owns. */
    border-radius: var(--of-bevel-radius);
    /* Every tab reserves the selected edge, so selecting one moves no pixels. */
    border-block-end: var(--of-bevel-width) solid transparent;
  }

  .version-tab:hover {
    color: var(--of-color-ink);
  }

  /*
    The current tab is marked by weight, ink AND a bevelled edge — three
    channels, because "which version am I reading" is the single most important
    fact on a page that shows one of three near-identical cards.
  */
  .version-tab.current {
    color: var(--of-color-ink);
    border-block-end-color: var(--of-color-accent);
  }

  .version-label {
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
  }

  .versions-note {
    margin: 0;
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-small);
  }

  .rail-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--of-space-base);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail-list li {
    display: flex;
    flex-direction: column;
    gap: var(--of-space-hair);
    align-items: center;
  }

  .rail-face {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
    border-radius: var(--of-bevel-radius);
    border: var(--of-bevel-width) solid var(--of-color-rule);
    background: var(--of-color-sunken);
  }

  /*
    The printing currently shown as the face. Marked with the accent edge rather
    than by dimming the others: a rail where five of six thumbnails are faded
    reads as five broken images.
  */
  .rail-face.current {
    border-color: var(--of-color-accent);
  }

  .rail-id {
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-wide);
    color: var(--of-color-ink-muted);
  }

  /* Layout and voice assignment only. Every value is a token — no literal
     colour, no literal length — and no media query, because a breakpoint is a
     length the token layer has nothing to offer. Everything below wraps or
     scrolls instead. */

  /* -- Breadcrumb ---------------------------------------------------------- */

  .lineage {
    margin-block-end: var(--of-space-looser);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--of-space-tight);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--of-type-size-small);
  }

  /* Generated content, so a separator never lands in copied text. */
  .crumbs li + li::before {
    content: "›";
    color: var(--of-color-ink-muted);
    margin-inline-end: var(--of-space-tight);
  }

  .crumb-current {
    color: var(--of-color-ink-muted);
  }

  /* -- Masthead ------------------------------------------------------------ */

  .masthead {
    margin-block-end: var(--of-space-looser);
  }

  .eyebrow {
    margin: 0;
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    font-weight: var(--of-type-weight-medium);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--of-space-base);
    margin-block-start: var(--of-space-tight);
  }

  /* Serif — the voice assigned to names. The layout already sets the display
     size on `h1`; what is added here is the margin reset the flex row needs. */
  .card-name {
    margin-block: 0;
    overflow-wrap: anywhere;
  }

  /* -- Shared apparatus ---------------------------------------------------- */

  .apparatus {
    margin-block: var(--of-space-looser);
  }

  /* A real heading, restyled rather than downgraded to a `<p>`: the level is
     what a screen reader navigates by, and the mono micro type is what keeps it
     from shouting over the card. Same idiom as the rules page. */
  .apparatus-heading {
    margin-block: 0 var(--of-space-base);
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    font-weight: var(--of-type-weight-medium);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
  }

  .scope {
    margin-block: 0 var(--of-space-base);
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-small);
    line-height: var(--of-type-leading-loose);
  }

  .void {
    margin: 0;
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-small);
  }

  /*
    THE RIGHTS NOTICE IS LEGALESE, NOT APPARATUS. It is 500 characters of
    licence text that has to be present and does not have to compete — the same
    argument the card-image copyright line settled, so it gets the same
    treatment: the smallest step in the scale, tight, faint.
  */
  .legal {
    margin-block-start: var(--of-space-base);
    font-size: var(--of-type-size-legal);
    letter-spacing: var(--of-type-tracking-tight);
    line-height: var(--of-type-leading-base);
    color: var(--of-color-ink-faint);
  }

  .verify {
    margin-block: var(--of-space-base) 0;
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-micro);
    line-height: var(--of-type-leading-loose);
  }

  /* -- Stats --------------------------------------------------------------- */

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--of-space-loose);
    margin: 0;
  }

  .stat dt {
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
  }

  .stat dd {
    margin: 0;
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-title);
    color: var(--of-color-ink);
  }

  /* The marker sits beside its word, at the label's own baseline. */
  .stat dt {
    display: flex;
    align-items: center;
    gap: var(--of-space-tight);
  }

  .stat-symbol {
    display: inline-flex;
  }

  /* -- Printed text -------------------------------------------------------- */

  /* The `.card-text` rule that lived here moved into `PrintedText.astro` along
     with the markup it styled. It is deleted rather than left behind: a scoped
     rule matching no element in its own component is dead weight that reads,
     to the next person, like the styling is still handled here. */

  /* -- Attributes ---------------------------------------------------------- */

  .attributes {
    display: grid;
    gap: var(--of-space-base);
    margin: 0;
  }

  .attribute {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--of-space-base);
  }

  .attribute dt {
    flex: 0 0 auto;
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
  }

  .attribute dd {
    flex: 1 1 60%;
    margin: 0;
    font-size: var(--of-type-size-small);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--of-space-tight);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Not a `StatePill`: a keyword is not a state, and the notch means "this
     carries state" everywhere else in the system. A hairline outline is the
     honest weight for a tag. */
  .tag {
    padding-block: var(--of-space-tightest);
    padding-inline: var(--of-space-tight);
    border: var(--of-bevel-width) solid var(--of-color-rule);
    border-radius: var(--of-bevel-radius);
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-wide);
    color: var(--of-color-ink-muted);
  }

  /* -- Legality ------------------------------------------------------------ */

  .formats {
    display: grid;
    gap: var(--of-space-looser);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .format {
    padding-block-start: var(--of-space-base);
    border-block-start: var(--of-ornament-rule-width) solid var(--of-color-rule);
  }

  .format-name {
    margin-block: 0 var(--of-space-tight);
    font-family: var(--of-type-family-serif);
    font-size: var(--of-type-size-large);
    letter-spacing: var(--of-type-tracking-tight);
    color: var(--of-color-ink);
  }

