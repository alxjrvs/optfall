---
/**
 * One card, in full — the body of `/card/<slug>`, and the thing `docs/PLAN.md`
 * Phase 2 says people arrive for.
 *
 * "Every view is a URL. `/card/command-and-conquer` … is the product, not
 * decoration on it." So this page is built to be *pasted*: the name is the
 * heading, the legality is dated and evidenced, and everything on it is either
 * a value read off the upstream record or a fixed label wrapped around one.
 *
 * SIX DECISIONS, EACH OF WHICH A REVIEWER SHOULD BE ABLE TO ARGUE WITH.
 *
 * **THE VERDICT IS A LIST OF PILLS, NEVER A SINGLE WORD, AND IT IS NEVER
 * `cc_legal`.** `apps/site/src/lib/cards.ts` derives it; this page only prints
 * what it derived. The distinction matters because upstream's `cc_legal` means
 * "in the Classic Constructed card pool" and is `true` on all 51 `cc_banned`
 * cards — rendering that flag as a Legal pill is precisely the incumbent bug
 * `docs/PLAN.md` Phase 3 cites as the reason this project exists. One card
 * (Winter's Wail) is `cc_banned` *and* `cc_living_legend`, so both pills render.
 *
 * **EVERY VERDICT PRINTS ITS EVIDENCE, INLINE AND UNCONDITIONALLY.** The raw
 * upstream keys sit directly beneath the pills, in the mono voice, with an
 * absent key shown as `—` rather than as `false`. `docs/PLAN.md`: the tool is
 * "auditable rather than merely assertive, which is what matters when the
 * commercially-backed incumbent ships incorrect flags". It is not behind a
 * disclosure widget, because a claim whose evidence needs a click is a claim
 * being asserted.
 *
 * **THE PAGE MAKES NO HISTORICAL CLAIM.** Every legality sentence here is
 * present-tense and stamped with the date the corpus was confirmed. `since`
 * dates are printed where upstream publishes one and are labelled as the start
 * of the *current* state, never as a history. Legality as of a date is Phase 3
 * and is named as absent rather than implied.
 *
 * **THE STAT BLOCK IS A `<dl>`.** Cost, Power, Defence, Life, Intellect and
 * Arcane are term-and-value data, so they are marked up as term-and-value data
 * rather than as a row of styled `<div>`s. A card with no power has no Power
 * row at all — and 13 cards genuinely have `power: "0"`, which is a different
 * fact and gets a row saying `0`.
 *
 * **EVERY LINK TO ANOTHER CARD RENDERS `link.label`, NEVER `link.name`.** 900
 * names in this corpus belong to two to four different cards, so a list of
 * anchors reading "Head Jab", "Head Jab", "Head Jab" pointing at three URLs is
 * both useless and a WCAG 2.4.4 failure. The label carries the variant suffix
 * and is composed once, in `cards.ts`, so a page cannot forget it.
 *
 * **NO CARD FACE IS RENDERED, DELIBERATELY.** Card images are permitted for
 * card databases on the condition that a copyright line accompanies them, and
 * `packages/components/src/index.ts` designs that condition to be
 * unrepresentable-if-missing by putting the notice inside a `CardImage`
 * primitive rather than in a prop. That primitive does not exist yet. Writing a
 * bare `<img>` here would satisfy neither "compose, never restyle" nor the
 * copyright condition, so the printings table cites the collector number, the
 * set and the artist — which is the citable identity of a printing — and no
 * face is shown until the primitive lands.
 *
 * Everything visible is composed from `optfall-components`. The styles below
 * are layout and voice assignment only, and every value in them is a
 * `var(--of-*)`; `bun run check:tokens` fails the build otherwise.
 */
import {
  BevelledPlate,
  CardFace,
  OrnamentalRule,
  PitchJewel,
  StatePill,
} from "optfall-components/svelte";

import {
  CORPUS,
  LAST_CONFIRMED,
  hrefForSlug,
  type CardLink,
  type CardPage,
} from "../lib/cards";
import {
  boxFor,
  faceKeyFor,
  faceUrl,
  orientationOf,
  placeholderUrl,
} from "../lib/faces";

interface Props {
  page: CardPage;
}

const { page } = Astro.props;
const { card } = page;

const typeLine = card.type_text.trim();
const text = card.functional_text.trim();

/**
 * Lists upstream publishes per card, rendered only where non-empty.
 *
 * Read off the record and labelled, never summarised. `traits` is populated on
 * 9 cards and `removed_keywords` on 12 — printing an empty "Traits: none" row
 * on the other 4,932 would be noise dressed as completeness.
 */
const vocabularies: readonly (readonly [string, readonly string[]])[] = [
  ["Types", card.types],
  ["Traits", card.traits],
  ["Keywords", card.card_keywords],
  ["Abilities and effects", card.abilities_and_effects],
  ["Ability keywords", card.ability_and_effect_keywords],
  ["Grants", card.granted_keywords],
  ["Removes", card.removed_keywords],
  ["Interacts with", card.interacts_with_keywords],
];
const vocabulary = vocabularies.filter(([, values]) => values.length > 0);

/**
 * Pitch leads the stat block rather than sitting only in the masthead jewel.
 *
 * The jewel is the reserved silhouette and carries pitch as shape, numeral and
 * colour; the `<dl>` is the tabular record, and a tabular record with a hole in
 * it where its most-read value should be is a worse artefact than a duplicated
 * one. Cards with no pitch get no row, exactly as they get no other absent stat.
 */
const stats =
  page.pitch === 0
    ? page.stats
    : [{ label: "Pitch", value: String(page.pitch) }, ...page.stats];

const nameHref = hrefForSlug(page.nameSlug);

/** Related-card lists, in the order they answer a question about this card. */
const related: readonly (readonly [string, string, readonly CardLink[]])[] = [
  ["Other versions", "Same name, different pitch.", page.variants],
  ["Names these cards", "Cards this card's text refers to by name.", page.references],
  ["Named by", "Cards whose text refers to this one by name.", page.referencedBy],
];
const relatedShown = related.filter(([, , links]) => links.length > 0);

const printingCount = card.printings.length;

/* -------------------------------------------------------------------------- */
/* The face                                                                    */
/* -------------------------------------------------------------------------- */

/**
 * The accessible name for the card's picture.
 *
 * FIXED LABELS AROUND VERBATIM VALUES, exactly as `titleFor` and
 * `descriptionFor` in `lib/cards.ts` are built — the card's own label and its
 * own printed type line, joined by an em dash this file supplies. Nothing here
 * describes the artwork, because Optfall has no way to know what is in it and a
 * generated description of a picture is precisely the composed prose the
 * project rules out. A reader who cannot see the image gets the card's identity,
 * which is what the image is doing on the page.
 */
const faceAlt = typeLine === "" ? page.label : `${page.label} — ${typeLine}`;

const faceBox = boxFor("normal", page.face.orientation);
const faceSrc =
  page.face.key === null
    ? placeholderUrl(page.face.orientation)
    : faceUrl(page.face.key, "normal");

/**
 * Every printing that publishes art, as a rail beneath the face.
 *
 * `docs/SCRYFALL-GAP.md` §5.1c: the printing is the addressable unit, and a
 * card averaging 3.3 of them should show them rather than list their codes in a
 * table. Printings with no published art are deliberately absent from the rail
 * — a row of NO IMAGE tiles would be a worse artefact than a shorter rail, and
 * the printings TABLE below still lists every one of them, so nothing is hidden.
 */
const rail = card.printings
  .map((printing) => {
    const key = faceKeyFor(printing.image_url);
    if (key === null) return null;
    const orientation = orientationOf({
      playedHorizontally: card.played_horizontally,
      rotationDegrees: printing.image_rotation_degrees,
    });
    return {
      key,
      orientation,
      id: printing.id,
      setId: printing.set_id,
      src: faceUrl(key, "thumb"),
      box: boxFor("thumb", orientation),
      current: printing.id === page.face.printingId,
    };
  })
  .filter((entry) => entry !== null);

/**
 * Shown only when there is a choice to make. One printing is not a rail, it is
 * the same picture again.
 */
const showRail = rail.length > 1;
---

<nav class="lineage" aria-label="Breadcrumb">
  <ol class="crumbs">
    <li><a href="/">Optfall</a></li>
    <li><a href="/cards">Cards</a></li>
    {
      page.disambiguated && (
        <li>
          <a href={nameHref}>{card.name}</a>
        </li>
      )
    }
    <li><span class="crumb-current" aria-current="page">{page.label}</span></li>
  </ol>
</nav>

<article>
  <header class="masthead">
    <p class="eyebrow">{typeLine === "" ? "Flesh and Blood card" : typeLine}</p>
    <div class="title-row">
      <PitchJewel value={page.pitch} size="lg" />
      <h1 class="card-name">{page.label}</h1>
    </div>
  </header>

  <!--
    THE PICTURE IS THE FIRST THING, because it is what somebody opening a card
    page came to see — docs/SCRYFALL-GAP.md, which settled that the card layer
    is the product rather than supporting cast.

    `loading="eager"` here and nowhere else on the site: this is the one face
    above the fold, and lazy-loading the thing the page is about only delays it.
  -->
  <div class="face-block">
    <CardFace
      src={faceSrc}
      alt={faceAlt}
      width={faceBox.width}
      height={faceBox.height}
      loading="eager"
    />

    {
      showRail && (
        <nav class="rail" aria-label={`Printings of ${page.label}`}>
          <ul class="rail-list">
            {rail.map((printing) => (
              <li>
                {/*
                  Not a link yet. Per-printing URLs are the next layer of this
                  work (docs/SCRYFALL-GAP.md §5.1c); until they exist, an anchor
                  would point at the page it is already on, which is a worse
                  affordance than a plain thumbnail. The collector number is the
                  accessible name because it is the citable identity of a
                  printing.
                */}
                <img
                  src={printing.src}
                  alt={`${page.label} — printing ${printing.id}`}
                  width={printing.box.width}
                  height={printing.box.height}
                  loading="lazy"
                  decoding="async"
                  class:list={["rail-face", { current: printing.current }]}
                />
                <span class="rail-id">{printing.id}</span>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>

  <section class="apparatus" aria-labelledby="stats">
    <h2 class="apparatus-heading" id="stats">Stats</h2>
    {
      stats.length === 0 ? (
        <p class="void">This card carries no printed cost, power, defence, life, intellect or arcane value.</p>
      ) : (
        <dl class="stats">
          {stats.map((stat) => (
            <div class="stat">
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </section>

  <section class="apparatus" aria-labelledby="printed-text">
    <h2 class="apparatus-heading" id="printed-text">Printed text</h2>
    {
      text === "" ? (
        <p class="void">This card has no rules text in the published dataset.</p>
      ) : (
        <BevelledPlate emphasis="raised">
          <p class="card-text">{card.functional_text}</p>
        </BevelledPlate>
      )
    }
    <!--
      Reproduced, not interpreted. Upstream writes emphasis as `**Ward 10**` and
      symbols as `{r}` / `{p}`, and Optfall has no published table mapping those
      markers to words — so substituting any would be inventing a vocabulary and
      calling it the card's text. `docs/PLAN.md`: every string served traces to a
      parsed source. The markers stay; the note says why.
    -->
    <p class="verify">Printed exactly as the upstream dataset publishes it, including its own <code>**</code> emphasis and <code>&#123;…&#125;</code> symbol markers. Optfall does not rewrite, expand or summarise card text.</p>
  </section>

  {
    vocabulary.length > 0 && (
      <section class="apparatus" aria-labelledby="attributes">
        <h2 class="apparatus-heading" id="attributes">Attributes</h2>
        <dl class="attributes">
          {vocabulary.map(([label, values]) => (
            <div class="attribute">
              <dt>{label}</dt>
              <dd>
                <ul class="tags">
                  {values.map((value) => (
                    <li class="tag">{value}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
          {card.played_horizontally && (
            <div class="attribute">
              <dt>Orientation</dt>
              <dd>Played horizontally</dd>
            </div>
          )}
        </dl>
      </section>
    )
  }
</article>

<OrnamentalRule label="Legality" />

<section class="apparatus" aria-labelledby="legality">
  <h2 class="apparatus-heading" id="legality">Legality</h2>

  <!--
    The scope of the claim, stated before the claim. `docs/PLAN.md`: "Every
    surface shows when its data was last confirmed", and Phase 3 — legality as
    of a date — is named as absent rather than left to be assumed present.
  -->
  <!--
    Inline elements stay on the same source line as the text around them. Astro
    compresses the built HTML and drops the whitespace at a line break falling
    immediately before an inline tag, which silently welds words together in the
    output — "last confirmed2026-08-10". Same trap `NoScriptNotice.astro`
    records; same fix.
  -->
  <p class="scope">
    Current state only, as published by the upstream dataset and last confirmed <time datetime={LAST_CONFIRMED}>{LAST_CONFIRMED}</time>. Optfall does not yet answer what was legal on an earlier date; where upstream publishes the date a state began, it is printed below and means the start of the state that applies now.
  </p>

  <ul class="formats">
    {
      page.verdicts.map((verdict) => (
        <li class="format">
          <h3 class="format-name" id={`format-${verdict.format.id}`}>
            {verdict.format.name}
          </h3>

          {verdict.unknown ? (
            <p class="void">
              The dataset publishes no legality flag for this format, so Optfall
              has nothing to say about this card in it. It publishes only
              exclusions here, and none is set on this card.
            </p>
          ) : (
            <ul class="states">
              {verdict.states.map((state) => (
                <li class="state">
                  <StatePill tone={state.tone} label={state.label} />
                  {state.since !== null && (
                    <span class="since">
                      since <time datetime={state.since}>{state.since}</time>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          )}

          {verdict.affectsFullCycle && verdict.format.id === "living-legend" && (
            <p class="scope">Upstream records this restriction as affecting the full cycle of cards sharing this name.</p>
          )}

          <dl class="evidence">
            {verdict.evidence.map((fact) => (
              <div class="fact" data-present={String(fact.present)}>
                <dt>{fact.key}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </li>
      ))
    }
  </ul>
</section>

<OrnamentalRule label="Printings" />

<section class="apparatus" aria-labelledby="printings">
  <h2 class="apparatus-heading" id="printings">Printings</h2>
  <p class="scope">
    {printingCount} printing{printingCount === 1 ? "" : "s"}. The collector number
    is the citable identity of a printing. Set, edition, foiling and rarity are
    upstream's own single-letter codes, reproduced rather than expanded — Optfall
    publishes no table mapping them to words, and inventing one would be a claim
    rather than a lookup. No card face is shown: images are permitted with a
    copyright line, and the component that carries that line unconditionally is
    not built yet.
  </p>

  <div class="scroller">
    <table class="printings">
      <caption class="visually-hidden">Every published printing of {page.label}</caption>
      <thead>
        <tr>
          <th scope="col">Number</th>
          <th scope="col">Set</th>
          <th scope="col">Rarity</th>
          <th scope="col">Edition</th>
          <th scope="col">Foiling</th>
          <th scope="col">Artist</th>
          <th scope="col">Other face</th>
        </tr>
      </thead>
      <tbody>
        {
          page.printings.map(({ printing, otherFace }) => (
            <tr>
              <th scope="row" class="collector">{printing.id}</th>
              <td class="code">{printing.set_id}</td>
              <td class="code">{printing.rarity === "" ? "—" : printing.rarity}</td>
              <td class="code">{printing.edition === "" ? "—" : printing.edition}</td>
              <td class="code">{printing.foiling === "" ? "—" : printing.foiling}</td>
              <td>{printing.artists.length === 0 ? "—" : printing.artists.join(", ")}</td>
              <td>
                {otherFace === null ? (
                  "—"
                ) : (
                  <a href={otherFace.href}>{otherFace.label}</a>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    page.printings.some(({ printing }) => printing.flavor_text.trim() !== "") && (
      <div class="flavour">
        <h3 class="apparatus-heading" id="flavour">Flavour text</h3>
        <dl class="attributes">
          {page.printings
            .filter(({ printing }) => printing.flavor_text.trim() !== "")
            .map(({ printing }) => (
              <div class="attribute">
                <dt class="collector">{printing.id}</dt>
                <dd class="flavour-text">{printing.flavor_text}</dd>
              </div>
            ))}
        </dl>
      </div>
    )
  }
</section>

{
  relatedShown.length > 0 && (
    <>
      <OrnamentalRule label="Related cards" />
      <section class="apparatus" aria-labelledby="related">
        <h2 class="apparatus-heading" id="related">Related cards</h2>
        {relatedShown.map(([label, blurb, links]) => (
          <div class="related">
            <h3 class="related-name">{label}</h3>
            <p class="scope">{blurb}</p>
            <ul class="links">
              {links.map((link) => (
                <li class="link">
                  <PitchJewel value={link.pitch} size="sm" />
                  {/*
                    `link.label`, never `link.name`. Two cards on this list can
                    share a name; the label is what makes the two anchors
                    distinguishable to somebody reading the links alone.
                  */}
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    </>
  )
}

<OrnamentalRule label="Source" />

<section class="apparatus" aria-labelledby="source">
  <h2 class="apparatus-heading" id="source">Source</h2>
  <BevelledPlate emphasis="sunken">
    <dl class="provenance">
      <dt>Upstream</dt>
      <dd><a class="source-url" href={`https://github.com/${CORPUS.source.repository}`}>{CORPUS.source.repository}</a></dd>

      <dt>File</dt>
      <dd><code>{CORPUS.source.path}</code></dd>

      <dt>Pinned commit</dt>
      <dd><code class="hash">{CORPUS.source.commit}</code></dd>

      <dt>Last confirmed</dt>
      <dd><time datetime={LAST_CONFIRMED}>{LAST_CONFIRMED}</time></dd>

      <dt>Retrieved from</dt>
      <dd><a class="source-url" href={CORPUS.source.url}>{CORPUS.source.url}</a></dd>

      <dt>File SHA-256</dt>
      <dd><code class="hash">{CORPUS.source.sha256}</code></dd>

      <dt>This card</dt>
      <dd><code>{card.unique_id}</code></dd>
    </dl>
  </BevelledPlate>
  <p class="verify">Card {page.ordinal} of {CORPUS.counts.cards}. Fetch that URL yourself, hash it and compare. Every value on this page is read from those exact bytes by deterministic code — no language model reads, rewrites or summarises any part of this corpus.</p>
  <p class="verify">{CORPUS.rights}</p>
</section>

<style>
  /* -- The face and its printings rail ------------------------------------- */

  /*
    Layout only. `CardFace` owns everything about how a face is drawn, including
    the copyright line it will not let a caller omit; this places it and nothing
    more.
  */
  .face-block {
    display: flex;
    flex-direction: column;
    gap: var(--of-space-base);
    margin-block-end: var(--of-space-looser);
    /* The face is a fixed-width object in a text column, not a banner. Held to
       its own measure so a wide viewport does not stretch a card to the width
       of a paragraph. */
    max-inline-size: fit-content;
  }

  .rail-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--of-space-base);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail-list li {
    display: flex;
    flex-direction: column;
    gap: var(--of-space-hair);
    align-items: center;
  }

  .rail-face {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
    border-radius: var(--of-bevel-radius);
    border: var(--of-bevel-width) solid var(--of-color-rule);
    background: var(--of-color-sunken);
  }

  /*
    The printing currently shown as the face. Marked with the accent edge rather
    than by dimming the others: a rail where five of six thumbnails are faded
    reads as five broken images.
  */
  .rail-face.current {
    border-color: var(--of-color-accent);
  }

  .rail-id {
    font-family: var(--of-type-family-mono);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-mono);
    color: var(--of-color-ink-muted);
  }

  /* Layout and voice assignment only. Every value is a token — no literal
     colour, no literal length — and no media query, because a breakpoint is a
     length the token layer has nothing to offer. Everything below wraps or
     scrolls instead. */

  /* -- Breadcrumb ---------------------------------------------------------- */

  .lineage {
    margin-block-end: var(--of-space-looser);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--of-space-tight);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--of-type-size-small);
  }

  /* Generated content, so a separator never lands in copied text. */
  .crumbs li + li::before {
    content: "›";
    color: var(--of-color-ink-muted);
    margin-inline-end: var(--of-space-tight);
  }

  .crumb-current {
    color: var(--of-color-ink-muted);
  }

  /* -- Masthead ------------------------------------------------------------ */

  .masthead {
    margin-block-end: var(--of-space-looser);
  }

  .eyebrow {
    margin: 0;
    font-family: var(--of-type-family-mono);
    font-size: var(--of-type-size-micro);
    font-weight: var(--of-type-weight-medium);
    letter-spacing: var(--of-type-tracking-mono);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--of-space-base);
    margin-block-start: var(--of-space-tight);
  }

  /* Serif — the voice assigned to names. The layout already sets the display
     size on `h1`; what is added here is the margin reset the flex row needs. */
  .card-name {
    margin-block: 0;
    overflow-wrap: anywhere;
  }

  /* -- Shared apparatus ---------------------------------------------------- */

  .apparatus {
    margin-block: var(--of-space-looser);
  }

  /* A real heading, restyled rather than downgraded to a `<p>`: the level is
     what a screen reader navigates by, and the mono micro type is what keeps it
     from shouting over the card. Same idiom as the rules page. */
  .apparatus-heading {
    margin-block: 0 var(--of-space-base);
    font-family: var(--of-type-family-mono);
    font-size: var(--of-type-size-micro);
    font-weight: var(--of-type-weight-medium);
    letter-spacing: var(--of-type-tracking-mono);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
  }

  .scope {
    margin-block: 0 var(--of-space-base);
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-small);
    line-height: var(--of-type-leading-loose);
  }

  .void {
    margin: 0;
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-small);
  }

  .verify {
    margin-block: var(--of-space-base) 0;
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-micro);
    line-height: var(--of-type-leading-loose);
  }

  /* -- Stats --------------------------------------------------------------- */

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--of-space-loose);
    margin: 0;
  }

  .stat dt {
    font-family: var(--of-type-family-mono);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-mono);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
  }

  .stat dd {
    margin: 0;
