---
/**
 * One page per addressable section of the Comprehensive Rules — 1,278 of them,
 * every one a permalink.
 *
 * `docs/PLAN.md` Phase 4: **"The permalink is the product. A judge pasting a
 * citation into Discord instead of describing which paragraph they mean is the
 * unprompted-share moment."** That sentence decides every argument on this
 * page, so it is worth being explicit about which arguments it decided.
 *
 * **THE IDENTIFIER IS THE HEADING.** Not the chapter title, not a rewritten
 * question, not "Rule 8.3.4b explained" — the `<h1>` is `cr:8.3.4b`, in the
 * mono voice, at display size, `user-select: all`. `docs/DESIGN.md`: "If it is
 * monospaced, you can paste it into an argument." The single most likely thing
 * a visitor does here is select that string and paste it somewhere else, so it
 * is the largest thing on the page and one click selects all of it.
 *
 * **THE TEXT IS VERBATIM, AND THE PAGE NEVER TRUNCATES IT.** Bullets, examples
 * and notes are rendered whole and in document order, with the document's own
 * `Example:` and `Note:` labels intact. Nothing on this page is summarised,
 * shortened or reworded — the one string this page builds rather than copies is
 * the `<meta>` description, which is explicitly marked with an ellipsis when it
 * is cut. See `descriptionFor` in `../../lib/rules.ts`.
 *
 * **CONTEXT IS PART OF THE CITATION.** A subrule read alone is a sentence
 * without a subject: `1.0.1a` says "if an effect directly contradicts a rule",
 * and *which* rules it is talking about lives one level up. So the breadcrumb
 * links the whole ancestor chain, the children are listed with their text
 * rather than merely their numbers, and previous/next let the corpus be read in
 * document order. `docs/DESIGN.md` calls this density without clutter, and the
 * mechanism it prescribes is hairline rules rather than cards — which is
 * `OrnamentalRule`, used plain and used repeatedly.
 *
 * **NO `StatePill` ON THIS PAGE, DELIBERATELY.** The pill is for something that
 * *carries state* — `Legal`, `Banned`, `Not in format`, `Unverified` — and a
 * paragraph of the Comprehensive Rules carries none of those. The nearest
 * temptation is `verified`, and taking it would be a real cost rather than a
 * cosmetic one: `docs/DESIGN.md` rations brass to judge attribution and nothing
 * else ("a material used once is a signal; used twice it is a theme"), and
 * Phase 5 stakes its whole two-tier contract on that seal meaning a named human
 * signed the ruling. Spending it here, on a page where no human signed
 * anything, would devalue the one signal the destination phase depends on. The
 * provenance this page *can* honestly assert is the document version, the
 * publication date and the SHA-256 of the retrieved PDF — so it asserts those,
 * in plain text, at the foot of the page.
 *
 * **NO FILIGREE EITHER.** It earns three roles and this page hosts none of
 * them: it is a reference entry, not a feature panel or a card frame, and
 * `docs/DESIGN.md` spends the section-rule ornament at most once per screen.
 * A page that appears 1,278 times is the last place to spend it.
 *
 * Everything visible is composed from `optfall-components`. The styles below
 * are layout and voice assignment only, and every value in them is a
 * `var(--of-*)`; `bun run check:tokens` fails the build otherwise.
 */
import { BevelledPlate, Citation, OrnamentalRule } from "optfall-components/svelte";

import BaseLayout from "../../layouts/BaseLayout.astro";
import cardsJson from "../../../../../data/rules/cr-2.14.0.json";
import { buildKeywordVocabulary, cardsByRule } from "../../lib/keywords";
import { CARD_PAGES } from "../../lib/cards";
import type { RulesCorpus } from "../../lib/search";
import {
  CORPUS,
  LEVEL_LABEL,
  RULE_PAGES,
  descriptionFor,
  permalinkFor,
  titleFor,
  type RulePage,
} from "../../lib/rules";

/**
 * Every section, statically. There is no fallback route and no catch-all
 * renderer: a URL either was published by Legend Story Studios or it 404s,
 * which is the honest behaviour for a citation index.
 */
export function getStaticPaths() {
  return RULE_PAGES.map((page) => ({
    params: { id: page.section.number },
    props: { page },
  }));
}

interface Props {
  page: RulePage;
}

/**
 * WHICH CARDS THIS RULE GOVERNS — the direction that makes a rules corpus worth
 * visiting rather than merely correct.
 *
 * `docs/PLAN.md` Phase 4 asks for the cross-reference in both directions, and a
 * rule that lists its cards is the half nothing else in the game has: the
 * Comprehensive Rules is a PDF with a search box, and no tool joins it to the
 * cards it governs.
 *
 * Built ONCE at module scope rather than per page. This route emits 1,278 rule
 * pages; rebuilding a 4,941-card index for each of them would be that work
 * 1,278 times over for an answer that does not change.
 */
const KEYWORD_VOCABULARY = buildKeywordVocabulary(
  cardsJson as unknown as RulesCorpus,
);

const CARDS_BY_RULE = cardsByRule(
  KEYWORD_VOCABULARY,
  CARD_PAGES.map((card) => ({
    label: card.label,
    href: card.href,
    keywords: [...card.card.card_keywords, ...card.card.ability_and_effect_keywords],
  })),
);

/**
 * How many cards a rule page lists before it stops being a rule page.
 *
 * `Go again` is on 1,434 cards. Printing all of them would bury the rule's own
 * text under a directory, so the list is capped and the true total is stated —
 * the same honesty the search results page keeps, and the link goes somewhere
 * that can show the rest.
 */
const CARD_LIST_LIMIT = 24;

const { page } = Astro.props;
const { section, ancestors, children, references, previous, next, ordinal } = page;

const governedCards = CARDS_BY_RULE.get(section.number) ?? [];
const governedShown = governedCards.slice(0, CARD_LIST_LIMIT);
/** The keyword these cards share, for the search link. Every entry agrees. */
const governedKeyword = governedShown[0]?.keyword ?? "";

const hasText = section.text.trim() !== "";
const hasBody =
  hasText ||
  section.bullets.length > 0 ||
  section.examples.length > 0 ||
  section.notes.length > 0;

const eyebrow =
  section.level === "chapter"
    ? LEVEL_LABEL[section.level]
    : `${LEVEL_LABEL[section.level]} · Chapter ${section.chapter}`;
---

<BaseLayout title={titleFor(page)} description={descriptionFor(page)}
  section="rules"
>
  <nav class="lineage" aria-label="Breadcrumb">
    <ol class="crumbs">
      <li><a class="home" href="/">Optfall</a></li>
      {
        ancestors.map((ancestor) => (
          <li>
            <Citation ruleId={ancestor.id} href={permalinkFor(ancestor)} />
            {ancestor.title !== null && <span class="crumb-title">{ancestor.title}</span>}
          </li>
        ))
      }
      <li><span class="crumb-current" aria-current="page">{section.id}</span></li>
    </ol>
  </nav>

  <article>
    <header class="masthead">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="rule-id">{section.id}</h1>
      {section.title !== null && <p class="rule-title">{section.title}</p>}
    </header>

    {
      hasBody ? (
        <div class="body">
          <BevelledPlate emphasis="raised">
            {hasText && <p class="rule-text">{section.text}</p>}
            {section.bullets.length > 0 && (
              <ul class="bullets">
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
            {section.examples.map((example) => (
              <p class="aside">{example}</p>
            ))}
            {section.notes.map((note) => (
              <p class="aside">{note}</p>
            ))}
          </BevelledPlate>
        </div>
      ) : (
        <p class="void">{LEVEL_LABEL[section.level]} headings carry no rule text of their own in the published document.</p>
      )
    }

    {
      references.length > 0 && (
        <section class="apparatus" aria-labelledby="cross-references">
          <h2 class="apparatus-heading" id="cross-references">Cross-references</h2>
          <ul class="citations">
            {references.map((reference) => (
              <li>
                {reference.target === null ? (
                  <code>{reference.id}</code>
                ) : (
                  <Citation ruleId={reference.id} href={permalinkFor(reference.target)} />
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  {
    governedCards.length > 0 && (
      <>
        <OrnamentalRule label="Cards" />
        <section class="apparatus" aria-labelledby="governs">
          <h2 class="apparatus-heading" id="governs">Cards this rule governs</h2>
          <p class="scope">
            {governedCards.length.toLocaleString("en-GB")} card{governedCards.length === 1 ? "" : "s"} print the keyword this section defines. Matched exactly against the vocabulary the Comprehensive Rules publishes — a card appears here because it carries the keyword, never because its text resembles this rule.
          </p>
          <ul class="governs-list">
            {governedShown.map((card) => (
              <li>
                <a href={card.href}>{card.label}</a>
              </li>
            ))}
          </ul>
          {governedCards.length > governedShown.length && (
            <p class="scope">
              <a href={`/search?q=${encodeURIComponent(`keyword:"${governedKeyword}"`)}`}>
                All {governedCards.length.toLocaleString("en-GB")} in card search
              </a>
            </p>
          )}
        </section>
      </>
    )
  }

  {
    children.length > 0 && (
      <>
        <OrnamentalRule label="Contents" />
        <section class="apparatus" aria-labelledby="contents">
          <h2 class="apparatus-heading" id="contents">Contents</h2>
          <ul class="entries">
            {children.map((child) => (
              <li>
                <Citation ruleId={child.id} href={permalinkFor(child)} />
                <span class="entry-text">{child.title ?? child.text}</span>
              </li>
            ))}
          </ul>
        </section>
      </>
    )
  }

  <OrnamentalRule label="Source" />

  <section class="apparatus" aria-labelledby="source">
    <h2 class="apparatus-heading" id="source">Source</h2>
    <BevelledPlate emphasis="sunken">
      <dl class="provenance">
        <dt>Document</dt>
        <dd>{CORPUS.game} — {CORPUS.title}, version {CORPUS.version}</dd>

        <dt>Published</dt>
        <dd><time datetime={CORPUS.publishedDateIso}>{CORPUS.publishedDateIso}</time></dd>

        <dt>This section</dt>
        <dd><Citation ruleId={section.id} href={permalinkFor(section)} version={section.version} /></dd>

        <dt>Retrieved from</dt>
        <dd><a class="source-url" href={CORPUS.sourceUrl}>{CORPUS.sourceUrl}</a></dd>

        <dt>PDF SHA-256</dt>
        <dd><code class="hash">{CORPUS.source.sha256}</code></dd>
      </dl>
    </BevelledPlate>
    <p class="verify">Hash the PDF at that URL yourself and compare. The text above is parsed from those exact bytes by deterministic code — no language model reads, rewrites or summarises any part of this corpus.</p>
  </section>

  <OrnamentalRule label="Document order" />

  <nav class="sequence" aria-label="Document order">
    {/*
      Each slot is a labelled group rather than a bare label above a link. A
      `Citation` names itself after the identifier it carries — that is the
      point of it — so a screen-reader user tabbing through would otherwise
      hear "cr:1.0.1, link" and "cr:1.0.1b, link" with nothing to say which
      way each one goes. The visible "Previous"/"Next" is right there for a
      sighted reader; `role="group"` with a name is how that same fact reaches
      the accessibility tree without an `aria-label` on the citation itself,
      which would shadow the identifier it exists to announce.
    */}
    <div class="sequence-slot" role="group" aria-label="Previous section">
      {
        previous !== null && (
          <>
            <span class="eyebrow">Previous</span>
            <Citation ruleId={previous.id} href={permalinkFor(previous)} />
          </>
        )
      }
    </div>

    <p class="ordinal">{ordinal} of {CORPUS.counts.total}</p>

    <div class="sequence-slot end" role="group" aria-label="Next section">
      {
        next !== null && (
          <>
            <span class="eyebrow">Next</span>
            <Citation ruleId={next.id} href={permalinkFor(next)} />
          </>
        )
      }
    </div>
  </nav>
</BaseLayout>

<style>
  /* -- Cards this rule governs --------------------------------------------- */

  .governs-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--of-space-tight) var(--of-space-loose);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--of-type-family-serif);
  }

  /* Layout and voice assignment only. Every value is a token — no literal
     colour, no literal length — and no media query, because a breakpoint is a
     length the token layer has nothing to offer. Everything below wraps
     instead. */

  /* -- Breadcrumb ---------------------------------------------------------- */

  .lineage {
    margin-block-end: var(--of-space-looser);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--of-space-tight);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crumbs li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--of-space-tight);
  }

  /* A separator glyph rather than a slash-shaped border: it is generated
     content, so it never lands in the copied text of a citation. */
  .crumbs li + li::before {
    content: "›";
    color: var(--of-color-ink-muted);
  }

  .home {
    font-size: var(--of-type-size-small);
  }

  .crumb-title {
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-small);
  }

  /* The current page is text, not a link — the standard breadcrumb ending, and
     the reason it is not a `Citation`: a citation is a link, and a link to the
     page you are on is a dead affordance. */
  .crumb-current {
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-small);
    letter-spacing: var(--of-type-tracking-wide);
    color: var(--of-color-ink-muted);
  }

  /* -- Masthead ------------------------------------------------------------ */

  .masthead {
    margin-block-end: var(--of-space-looser);
  }

  .eyebrow {
    margin: 0;
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    font-weight: var(--of-type-weight-medium);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
  }

  /* THE THING PEOPLE COPY. Mono, because the mono voice is what marks a string
     as citable; display size, because it is the subject of the page; and
     `user-select: all` so one click takes the whole identifier and never half
     of it — `cr:8.3.4` is not a shorter citation than `cr:8.3.4b`, it is a
     different and wrong one. Same reasoning as `Citation.svelte`, which is
     where this convention comes from. */
  .rule-id {
    margin-block: var(--of-space-tight) 0;
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-display);
    font-weight: var(--of-type-weight-medium);
    letter-spacing: var(--of-type-tracking-wide);
    color: var(--of-color-ink);
    user-select: all;
    overflow-wrap: anywhere;
  }

  /* Serif — one of the three assigned voices, and the one for names. */
  .rule-title {
    margin-block: var(--of-space-tight) 0;
    font-family: var(--of-type-family-serif);
    font-size: var(--of-type-size-title);
    line-height: var(--of-type-leading-tight);
    letter-spacing: var(--of-type-tracking-tight);
    color: var(--of-color-ink);
  }

  /* -- The rule itself ----------------------------------------------------- */

  .body {
    margin-block: var(--of-space-looser);
  }

  /* One step above interface size and on the loose leading: this is the only
     running prose on the page and the only reason anyone came. */
  .rule-text {
    margin: 0;
    font-size: var(--of-type-size-large);
    line-height: var(--of-type-leading-loose);
  }

  .bullets {
    margin-block: var(--of-space-loose) 0;
    padding-inline-start: var(--of-space-looser);
  }

  .bullets li {
    margin-block-end: var(--of-space-tight);
  }

  /* Examples and notes arrive from the parser with the document's own
     `Example:` / `Note:` label already on them, so the rule below adds a
     hairline and subordinate ink and invents no label of its own. */
  .aside {
    margin-block: var(--of-space-loose) 0;
    padding-inline-start: var(--of-space-base);
    border-inline-start: var(--of-bevel-width) solid var(--of-color-rule-strong);
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-small);
    line-height: var(--of-type-leading-loose);
  }

  /* Degrade visibly: a chapter or section heading genuinely has no prose in the
     published document, and saying so is better than rendering an empty plate
     that reads as a parse failure. */
  .void {
    margin: 0;
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-small);
  }

  /* -- Apparatus ----------------------------------------------------------- */

  .apparatus {
    margin-block: var(--of-space-looser);
  }

  /* The label voice, applied to a real `<h2>`. The heading level is what a
     screen reader navigates by; the mono micro type is what keeps it from
     shouting over the rule text, which is the thing on this page that matters.
     Restyling rather than downgrading to a `<p>` is the whole difference. */
  .apparatus-heading {
    margin-block: 0 var(--of-space-base);
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    font-weight: var(--of-type-weight-medium);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
  }

  .citations {
    display: flex;
    flex-wrap: wrap;
    gap: var(--of-space-tight);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entries {
    display: grid;
    gap: var(--of-space-base);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Number and text on one line where there is room, wrapping to two where
     there is not — no breakpoint, and therefore no literal length. */
  .entries li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--of-space-base);
  }

  .entry-text {
    flex: 1 1 60%;
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-small);
    line-height: var(--of-type-leading-base);
  }

  /* -- Provenance ---------------------------------------------------------- */

  .provenance {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: var(--of-space-tight) var(--of-space-loose);
    margin: 0;
  }

  .provenance dt {
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-wide);
    text-transform: uppercase;
    color: var(--of-color-ink-muted);
    white-space: nowrap;
  }

  .provenance dd {
    margin: 0;
    font-size: var(--of-type-size-small);
  }

  .source-url,
  .hash {
    overflow-wrap: anywhere;
  }

  .verify {
    margin-block: var(--of-space-base) 0;
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-micro);
    line-height: var(--of-type-leading-loose);
  }

  /* -- Document order ------------------------------------------------------ */

  .sequence {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--of-space-base);
    margin-block: var(--of-space-looser);
  }

  .sequence-slot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--of-space-tighter);
  }

  .sequence-slot.end {
    align-items: flex-end;
  }

  .ordinal {
    margin: 0;
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-micro);
    letter-spacing: var(--of-type-tracking-wide);
    color: var(--of-color-ink-muted);
    text-align: center;
  }
</style>
