---
/**
 * Home — `optfall.com`. **A door, not a room.**
 *
 * WHAT THIS PAGE IS FOR: taking a card name and sending you somewhere. That is
 * the whole brief, and everything not serving it has been taken off.
 *
 * WHAT IT LOOKED LIKE BEFORE. 474 words and 32 links — twenty-four of them a
 * browse list of type lines — two dense provenance paragraphs, a hint teaching
 * six operators, and the full card-search index: about 470 KB of inverted
 * postings, keyword memberships and per-format verdict vectors, shipped to a
 * browser so it could render a list of links. A reference tool's front page had
 * become a page *about* the reference tool.
 *
 * WHAT IT SHIPS NOW: `lib/typeahead.ts`'s index — names, slugs and pitches.
 * Everything the door needs and nothing the room does.
 *
 * THE RESULTS MOVED TO `/cards`, and that is the substance of the change rather
 * than a detail of it. A page that both takes a query and renders the answer
 * has to hold two states, and the empty one is what was noisy: with no results
 * to show, it filled itself with things to look at. Splitting them lets the
 * door be empty on purpose.
 *
 * `/cards` WAS A 301 TO HERE AND IS A PAGE AGAIN. That redirect landed earlier
 * in the same pass that moved card search to the front door; it is removed
 * rather than left pointing at a page that no longer answers queries, because a
 * 301 to a door is worse than the 404 it replaced.
 */
import { Mark } from "optfall-components/svelte";

import BaseLayout from "../layouts/BaseLayout.astro";
import NoScriptNotice from "../components/NoScriptNotice.astro";
import CardTypeahead from "../components/CardTypeahead.svelte";
import CardFan from "../components/CardFan.svelte";
import type { FanCard } from "../components/CardFan.svelte";
import { buildNameIndex } from "../lib/typeahead";
import { CARD_PAGES, CORPUS, LAST_CONFIRMED } from "../lib/cards";

const names = buildNameIndex(CARD_PAGES);

/** Stated rather than typed into prose, so it cannot rot at the next sync. */
const cards = CORPUS.counts.cards.toLocaleString("en-GB");

/**
 * THE SIX ARE NOT A RANDOM SELECTION. THEY ARE THE JOKE.
 *
 * Optfall is a tonal copy of Scryfall and does not pretend otherwise —
 * `docs/SCRYFALL-GAP.md` is a document about taking that site's address
 * grammar, its query syntax, its layout and its name. These six card names are
 * that admission, said in the game's own words on the one surface where the
 * project gets to have a voice:
 *
 *   Homage to Ancestors   — an homage, stated outright
 *   Preserve Tradition    — keeping the form we were handed
 *   Path Well Traveled    — walking a route somebody else laid
 *   Retrace the Past      — going back over it line by line
 *   Light Fingers         — taking what is not ours
 *   Semblance             — and looking like the thing we took it from
 *
 * The door is the one place a reference tool gets to say what it thinks it is
 * doing without writing a sentence about it, and this is cheaper and truer
 * than a paragraph claiming originality nobody would believe.
 *
 * SIX RATHER THAN EIGHT because the row has to keep every card's NAME legible —
 * each overlaps its neighbour, so the count and the band width together decide
 * how much of each name survives, and eight left the last two captioned by
 * fragments. Which means the joke has a hard constraint: a seventh card cannot
 * be added without taking one out.
 *
 * THEY ARE NAMED, NOT SAMPLED. A random six would change on every build, which
 * makes the front page a thing that cannot be reviewed — and would lose the
 * joke entirely the first time it dealt six equipment cards.
 *
 * A NAME THAT STOPS RESOLVING FAILS THE BUILD rather than dropping a card.
 * Five cards in a row built for six is a gap, and a gap that appears at the
 * next corpus sync with nothing to explain it is worse than a red build now.
 */
const FAN_NAMES = [
  "Homage to Ancestors",
  "Preserve Tradition",
  "Path Well Traveled",
  "Retrace the Past",
  "Light Fingers",
  "Semblance",
] as const;

const fan: readonly FanCard[] = FAN_NAMES.map((name) => {
  const matches = CARD_PAGES.filter((page) => page.card.name === name);

  if (matches.length !== 1) {
    throw new Error(
      `index.astro: "${name}" resolves to ${matches.length} card pages, not 1. The front-door row names its six cards so the page is reviewable; fix the name or replace it rather than letting the row render short.`,
    );
  }

  const page = matches[0]!;

  /*
    BOTH HALVES, because they are two different absences. `face` is null when
    the page has no printing to show at all; `face.key` is null when there is a
    printing and upstream publishes no image for it. Either one renders a
    placeholder where the front page expects art, so either one is a build
    failure rather than a card quietly missing from the hand.
  */
  if (page.face === null || page.face.key === null) {
    throw new Error(
      `index.astro: "${name}" has no face in the corpus, so the row would render a placeholder on the front page. Replace it with a card that has art.`,
    );
  }

  return {
    slug: page.slug,
    label: page.label,
    /* Nullable upstream — four cards publish no type line, and an alt text
       reading "Semblance — null" is worse than one that is just the name. */
    typeLine: page.card.type_text ?? "",
    faceKey: page.face.key,
  };
});
---

<BaseLayout
  title="Optfall — Flesh and Blood card search"
  description="Search every Flesh and Blood card. Every card has a permanent, citable URL with its printed text, its printings and its per-format legality — and every legality verdict shows the upstream flags it was derived from."

  section="none"
>
  <div class="door">
    <!--
      The name at the size a masthead wants, not the size a logo wants.
      `docs/DESIGN.md`: no marketing hero, no illustration above the fold — the
      first thing on the page is the thing you came to do, and the wordmark's
      only job is to say where you are.

      THE MARK IS PART OF THE NAME HERE, not an illustration above it. That
      distinction is the whole reason it is allowed on this page: a mark set
      beside the word at the word's own size is a masthead, while the same mark
      given its own line above the word is the hero the door refuses. It is
      `lg` — one step up from the header bar's `sm`, because this is the only
      page where the wordmark is the masthead rather than a way home — and
      decorative, since the `<h1>` beside it already carries the name and a
      named mark would make the page's one heading announce itself twice.

      AND IT IS THE CANONICAL PITCH VARIANT, which the header bar's is not.
      This is the one surface where the mark is identity rather than chrome, so
      it is the one that spends the three-value palette; the bar uses `ink`
      because a lockup that is a LINK has to light up as one object, and only
      the ink variant inherits the word's colour.
    -->
    <h1 class="wordmark"><Mark size="lg" decorative />Optfall</h1>

    <NoScriptNotice example="/search?q=banned:cc">Every card is addressable without it: <code>/card/command-and-conquer</code> is that card, and a name shared by several cards — <code>/card/head-jab</code> — is that card too, with its pitch versions as tabs.</NoScriptNotice>

    <!--
      `client:load`, not `client:visible`. The field is the only thing on this
      page and the whole reason anyone opened it, so it is hydrated before it is
      looked at rather than after.
    -->
    <CardTypeahead index={names} action="/search" client:load />

    <!--
      Four links, each going somewhere that ANSWERS a question rather than
      describing the answer. The five paragraphs of "what this is" that used to
      sit here were the page explaining itself to somebody who had already
      arrived.
    -->
    <nav class="ways-in" aria-label="Elsewhere in Optfall">
      <a href="/search">Browse all {cards} cards</a>
      <a href="/sets">Browse by set</a>
      <a href="/cr">Search the rules</a>
      <a href="/card/winters-wail">A card that is two things at once</a>
      <a href="/cr/1.0.1a">A rules permalink</a>
    </nav>
  </div>

  <!--
    BELOW THE FIELD AND BELOW THE LINKS, in the empty half of the screen the
    door already had. It is rendered without a `client:` directive on purpose:
    Astro builds it to markup on the build machine, so the row costs the page
    six images and no JavaScript at all.
  -->
  <CardFan cards={fan} />

  <!--
    Degrade visibly — one line, at the foot, in the quiet voice. The full
    provenance (commit, byte count, hash) lives on `/cards`, which is the
    surface that actually serves the data.
  -->
  <p class="stamp">
    {cards} cards, last confirmed {LAST_CONFIRMED}. Nothing here is summarised, paraphrased or generated.
  </p>
</BaseLayout>

<style>
  /*
    Stacking and voice assignment only. Nothing here draws anything: no box, no
    shadow, no border beyond the hairlines the system already owns.

    The door is given vertical room rather than centred in the viewport. A hero
    that vertically centres itself has to guess the viewport height, and guesses
    wrong on the phone where it matters most.
  */
  /*
    A LANDING, NOT A PAGE HEADER. Scryfall's front door is deliberately
    Google-shaped — one field, centred, with the rest of the site as small links
    under it — and this was a left-aligned column with the field partway down.
    The difference is not decoration: a centred field reads as "this is the
    thing to do", where the same field left-aligned under a wordmark reads as
    the first item in a document.

    Centred HORIZONTALLY and pushed down vertically, rather than centred in the
    viewport. Vertical centring has to guess a viewport height, and guesses
    worst on the phone, where the keyboard takes half of it.
  */
  .door {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--of-space-looser);
    padding-block-start: var(--of-space-loosest);
  }

  /* The block is centred; the field and its hint keep the page's width and stay
     left-aligned inside it, because a centred hint is a hint nobody reads.

     `layout.page.measure` rather than `type.measure`: this caps a CONTAINER —
     the field is not a line of prose — and the front door is the one page that
     does not get its width from `main`, so it has to name the same token
     `BaseLayout` does or it silently stops agreeing with every other page the
     moment either value moves. */
  .door > :global(*) {
    inline-size: 100%;
    max-inline-size: var(--of-layout-page-measure);
  }

  /*
    Small, tracked and quiet. The field below is the loud thing on this page,
    and a wordmark competing with it would be the marketing hero the design
    language refuses.
  */
  /*
    The masthead of a landing page rather than a breadcrumb. It was the small
    tracked label the header bar now carries on every other page — correct
    there, and wrong here, where it is the only thing above the field.
  */
  /*
    Centred as a lockup rather than as text. `text-align` centres the line box,
    which is the wrong unit once the heading holds a mark as well as a word: it
    would centre the two together and leave the mark's optical weight pulling
    the pair off centre. A flex row centres the box, and `align-items: center`
    sets the mark on the word's centre line rather than its baseline — a
    baseline-aligned octagon reads as having fallen out of the word, which is a
    joke the mark is already making once and does not need to make twice.
  */
  .wordmark {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--of-space-base);
    font-family: var(--of-type-family-serif);
    font-size: var(--of-type-size-display);
    letter-spacing: var(--of-type-tracking-tight);
    color: var(--of-color-ink);
  }

  .ways-in {
    display: flex;
    flex-wrap: wrap;
    gap: var(--of-space-base) var(--of-space-looser);
    font-size: var(--of-type-size-small);
  }

  .stamp {
    text-align: center;
    margin-block-start: var(--of-space-loosest);
    padding-block-start: var(--of-space-loose);
    border-block-start: var(--of-ornament-rule-width) solid var(--of-color-rule);
    color: var(--of-color-ink-faint);
    font-size: var(--of-type-size-small);
  }
</style>
