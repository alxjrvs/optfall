---
/**
 * The `/card/` route — 4,941 card pages and 900 disambiguation pages, every one
 * a permalink.
 *
 * `docs/PLAN.md` Phase 2: **"Every view is a URL. `/card/command-and-conquer`
 * and `/search?q=…` are the product, not decoration on it … a card page that
 * cannot be linked is a lookup rather than a reference."** This file is the
 * whole of what makes that true — `apps/site/src/lib/cards.ts` already derived
 * every slug, every verdict and every link, and until this route existed all of
 * it was unreachable: `CARD_ROUTES` had zero consumers, and Astro emitted
 * nothing under `dist/card/`.
 *
 * THREE THINGS THIS FILE DECIDES.
 *
 * **One route, two kinds of page.** `CardRoute` is a discriminated union, so
 * the branch below is exhaustive by construction: a third kind of route added
 * to `cards.ts` fails the typecheck here rather than silently rendering as a
 * card. Two components rather than one with conditionals inside it, because the
 * disambiguation page is a genuinely different document — it has no stats, no
 * legality and no printings, and a component pretending to be both would be
 * mostly `{#if}`.
 *
 * **Every path is emitted at build time. There is no fallback renderer.** A URL
 * either names a card Legend Story Studios has printed or it 404s, which is the
 * honest behaviour for a reference index — the same rule `/cr/[...id].astro`
 * follows. `output: "static"` in `astro.config.mjs` makes that structural.
 *
 * **The `<title>` and the description are built in `cards.ts`, not here.** They
 * are fixed labels wrapped around verbatim values, and they live beside the
 * data so that the two cannot drift. Note in particular that
 * `descriptionFor` deliberately omits legality: an unfurl preview is
 * snapshotted at paste time and never revisited, so "Banned in Classic
 * Constructed" is exactly the sentence that must not be cached for six months
 * in the conversation where someone is deciding what to sleeve.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardEntry from "../../components/CardEntry.astro";
import {
  CARD_ROUTES,
  NAME_PAGES,
  descriptionFor,
  hrefForSlug,
  titleFor,
  type CardRoute,
} from "../../lib/cards";

/**
 * Every card URL, statically.
 *
 * `[...slug]` rather than `[slug]` so the route owns the whole remainder of the
 * path: a slug is `a-z0-9-` by construction (see `slugify`), so the two are
 * equivalent today — and the rest parameter is what keeps a future slug
 * containing a separator from silently becoming an unreachable URL instead of a
 * build failure.
 */
export function getStaticPaths() {
  return CARD_ROUTES.map((route) => ({
    params: { slug: route.slug },
    props: { route },
  }));
}

interface Props {
  route: CardRoute;
}

const { route } = Astro.props;

/**
 * THE BARE NAME SLUG IS THE CARD, NOT AN INDEX OF CARDS.
 *
 * `/card/head-jab` used to be a disambiguation page: a list of links asking the
 * reader to pick a pitch before they were shown anything. That was the wrong
 * document, because a player calls the red, yellow and blue versions ONE card —
 * so the guessable URL now serves the card itself, at its lowest-pitch version,
 * with the tab strip in `CardEntry` switching between them.
 *
 * `NAME_PAGES` sorts its cards by pitch (`byPitch` in `cards.ts`, no-pitch
 * last), so `cards[0]` is the lowest-pitch version and the choice is total
 * rather than dependent on iteration order. The fallback is unreachable —
 * a name page exists only where a group has more than one card — and is
 * written rather than asserted because a `!` here would be a claim about
 * another module's invariant.
 */
const page = route.kind === "card" ? route.page : route.page.cards[0];

/**
 * The bare-name route names the CARD; a `-N` route names a version.
 *
 * `titleFor` defaults to `page.label`, which carries the variant suffix —
 * "Head Jab (pitch 2)" — and that is right on `/card/head-jab-2`, which is the
 * pitch-2 version's own address. It is wrong on `/card/head-jab`: that page
 * heads itself "Head Jab" and presents all three versions as tabs, so a
 * `<title>` reading "Head Jab (pitch 1)" contradicts the page and, worse,
 * follows the link into a browser tab and an unfurl preview, where it is the
 * only thing a reader sees.
 *
 * The description is deliberately left alone. It carries the stat line of the
 * version actually rendered — "Pitch 1 · Cost 0 · Power 3" — which is what the
 * page shows on arrival, and the stats genuinely differ between versions.
 */
/**
 * `/card/head-jab` and `/card/head-jab-1` render the same card at the same
 * version, so one of them has to say which is the real address.
 *
 * The BARE NAME wins, because it is the URL a person guesses, types and pastes
 * — `slugify` exists to make it guessable — and because it is the one that
 * survives upstream printing a fourth pitch version. Roughly 900 pairs;
 * without this they are 900 requests to a search engine to pick for us.
 *
 * A non-default version keeps its own canonical: `/card/head-jab-2` is not a
 * duplicate of anything.
 */
const DEFAULT_SLUG_BY_NAME = new Map(
  NAME_PAGES.map((name) => [name.slug, name.cards[0]?.slug]),
);

const canonical = (() => {
  if (page === undefined) return undefined;
  // The name route IS the bare name; it canonicals to itself by default.
  if (route.kind === "name") return hrefForSlug(page.nameSlug);
  // A variant page duplicates the bare name ONLY if it is the version that
  // page renders — the lowest-pitch one. An earlier attempt compared the slug
  // to `<nameSlug>-<pitch>`, which is true of EVERY variant, so pitch 2 and
  // pitch 3 each declared themselves duplicates of pitch 1. They are different
  // cards with different text and different legality; saying otherwise would
  // ask a search engine to drop two thirds of the corpus.
  const isDefault = DEFAULT_SLUG_BY_NAME.get(page.nameSlug) === page.slug;
  return isDefault ? hrefForSlug(page.nameSlug) : undefined;
})();

const title =
  page === undefined
    ? ""
    : route.kind === "name"
      ? titleFor(page, route.page.name)
      : titleFor(page);
---

{
  page === undefined ? null : (
    <BaseLayout title={title} description={descriptionFor(page)} canonical={canonical}>
      <CardEntry page={page} />
    </BaseLayout>
  )
}
