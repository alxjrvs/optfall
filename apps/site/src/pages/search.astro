---
/**
 * `/search` — and `/search?q=banned:cc`, which is the same page with an answer
 * on it. **The room the front door opens onto.**
 *
 * IT IS AT `/search` BECAUSE THAT IS WHERE PEOPLE LOOK. Scryfall's results live
 * at `/search?q=`, and `docs/DESIGN.md` settled that the grammar is inherited
 * rather than invented — "people arrive already fluent". The address is part of
 * the grammar: somebody who knows one card site knows to type `/search`, and
 * this page used to be at `/cards` while `/search` answered the Comprehensive
 * Rules, which is the least helpful arrangement available.
 *
 * `/cards` is a permanent redirect here, so every link already pasted survives.
 *
 * THE SPLIT FROM `/` IS UNCHANGED. The door takes a name and sends you
 * somewhere; this page renders the answer. The door ships names, slugs and
 * pitches; this ships the full index — inverted postings over printed text,
 * keyword and trait memberships, per-format verdict vectors. Somebody looking
 * up "head jab" never downloads the machinery.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import NoScriptNotice from "../components/NoScriptNotice.astro";
import CardSearch from "../components/CardSearch.svelte";
import { buildCardIndex } from "../lib/card-search";
import { CARD_PAGES, CORPUS, LAST_CONFIRMED, NAME_PAGES } from "../lib/cards";
import rulesJson from "../../../../data/rules/cr-2.14.0.json";
import { buildKeywordVocabulary, keywordCoverage } from "../lib/keywords";
import type { RulesCorpus } from "../lib/search";

/*
 * Built here, once, at build time, from the same shaped pages `/card/<slug>`
 * renders — which is what makes it impossible for a search result and the page
 * it links to to disagree about a slug, a label, a legality verdict or a face.
 * The 16 MB corpus stays on the build machine.
 */
const index = buildCardIndex(CARD_PAGES, {
  commit: CORPUS.source.commit,
  confirmed: LAST_CONFIRMED,
});

const cards = CORPUS.counts.cards.toLocaleString("en-GB");
const printings = CORPUS.counts.printings.toLocaleString("en-GB");
const permalinks = (CARD_PAGES.length + NAME_PAGES.length).toLocaleString("en-GB");
const upstream = `https://github.com/${CORPUS.source.repository}`;

/**
 * THE JOIN'S COVERAGE, STATED RATHER THAN IMPLIED.
 *
 * Card keywords are matched to the Comprehensive Rules sections that define
 * them, and the match is exact against a closed vocabulary — so some keywords
 * do not resolve. `docs/PLAN.md`: "A stale Optfall must look stale", and a join
 * that quietly drops what it cannot answer is asserting a completeness it does
 * not have. The number is computed here rather than typed, so it cannot rot
 * when either document is re-synced.
 */
const coverage = keywordCoverage(
  buildKeywordVocabulary(rulesJson as unknown as RulesCorpus),
  CORPUS.cards.flatMap((card) =>
    card.card_keywords.concat(card.ability_and_effect_keywords),
  ),
);
const unmatchedList = coverage.unmatched.join(", ");
---

<BaseLayout
  title="Search the cards — Optfall"
  description="Lexical search over every Flesh and Blood card. Every card has a permanent, citable URL, with per-format legality and the upstream flags it was derived from."

  section="cards"
  headerSearch={false}
>
  <!--
    NO `<h1>` HERE, AND THAT IS THE POINT OF THIS LAYER. It read "Search the
    cards", and the field's own visible `<label>` — the one that is `for=` the
    input, so it is the name a screen reader actually announces — reads "Search
    the cards" too, immediately beneath it. The nav above says "Cards" and the
    document title says "Search the cards — Optfall". Four statements of the
    same fact, and the display-sized one was costing the most fold on the page
    that can least afford it.

    The label is the better of the two to keep: it names the control rather than
    the page, it is what a screen reader reads out on focus, and it is already
    at the size an interface label should be. The `<title>` carries the page's
    name for anything that needs it.
  -->

  <!--
    THIS IS THE PAGE THE NO-JS FAILURE LANDS ON. The form submits here, so a
    reader with scripting off arrives at `/search?q=…` with a query in the
    address bar and no machinery on the page able to answer it. Without this
    block that reads as an empty field and nothing else — a silent failure,
    which is the one shape "degrade visibly" forbids.
  -->
  <NoScriptNotice example="/search?q=banned:cc">Every card is addressable without it: <code>/card/command-and-conquer</code> is that card, and a name shared by several cards — <code>/card/head-jab</code> — is that card too, with its pitch versions as tabs.</NoScriptNotice>

  <CardSearch index={index} ornament client:load />

  <!--
    Degrade visibly, on the surface that serves the data rather than on the one
    that links to it. Inline elements stay on the same source line as the text
    around them: the build drops the whitespace at a line break falling
    immediately before an inline tag, welding words together in the output.
  -->
  <p class="provenance">
    {cards} cards and {printings} printings at {permalinks} permanent URLs, from <a href={upstream}>{CORPUS.source.repository}</a> at <code>{CORPUS.source.commit}</code>, confirmed {LAST_CONFIRMED}. Legality is present day only; the query language says so rather than guessing. Nothing here is summarised or generated.
  </p>

  <p class="provenance">
    Card keywords are matched to the Comprehensive Rules section that defines each one, and every card page cites the rules that govern it. Coverage is <strong>{coverage.percent}%</strong> — {coverage.direct + coverage.viaFamily} of {coverage.baseForms} distinct keywords, {coverage.direct} matched directly and {coverage.viaFamily} through a rule the document parameterises. The {coverage.unmatched.length} it cannot resolve are named rather than hidden: {unmatchedList}. A keyword the rules do not define carries no citation instead of a guessed one.
  </p>

  <p class="legal">{CORPUS.rights}</p>
</BaseLayout>

<style>
  /* The rights notice is legalese: present, not competing. */
  .legal {
    margin-block-start: var(--of-space-base);
    font-size: var(--of-type-size-legal);
    letter-spacing: var(--of-type-tracking-tight);
    color: var(--of-color-ink-faint);
  }

  .provenance {
    margin-block-start: var(--of-space-loosest);
    color: var(--of-color-ink-muted);
    font-size: var(--of-type-size-small);
  }
</style>
