---
/**
 * The site's one layout, assembled from the token layer.
 *
 * This replaces the Phase 0 placeholder block wholesale, which is what that
 * block's own comment asked for. The rule it now obeys is `docs/PLAN.md`,
 * "Rules that hold across every phase": **compose, never restyle** — a screen
 * that needs new CSS is a signal the library is missing a primitive, and the
 * primitive gets added there rather than here.
 *
 * So every value below is `var(--of-*)`. `scripts/check-tokens.ts` enforces
 * that and the `tokens` CI job is in the aggregate gate — and because this
 * directory's deferral in that script FAILS once the path is clean, landing
 * this change is what deletes the exemption. An exemption that outlives its
 * reason is how a rule quietly stops applying.
 *
 * The theme stylesheet is generated from the token tables at build time rather
 * than written out as CSS. There is no second declaration of the palette to
 * drift, which is the same argument the Storybook preview makes.
 */
import { themeStylesheet } from "optfall-theme";

import SiteHeader from "../components/SiteHeader.astro";
import ComplianceFooter from "../components/ComplianceFooter.astro";

interface Props {
  /**
   * The address this page wants to be known by, root-relative.
   *
   * Defaults to the page's own URL, which is right for almost everything. It is
   * passed explicitly where two URLs render the same document: `/card/head-jab`
   * and `/card/head-jab-1` are the same card at the same version, and without a
   * canonical they are roughly 900 duplicate pairs asking a search engine to
   * pick one.
   */
  canonical?: string;
  /**
   * Which nav item to mark current, and whether the bar appears at all.
   *
   * `"none"` is the front door: that page IS the search field, and a second one
   * above it would be the same control twice. Scryfall does not carry its bar
   * on its landing page either.
   */
  section?: "cards" | "sets" | "rules" | "syntax" | "none";
  /**
   * Whether the header bar carries its own search field.
   *
   * `false` on the two pages that render one themselves. It is a separate
   * question from `section`, because `section="rules"` covers both `/cr` — which
   * has a field — and the 1,278 rule pages, which do not.
   */
  headerSearch?: boolean;
  title: string;
  description?: string;
  /**
   * How wide the content column is allowed to get.
   *
   * `"measure"` — the default, and right for every page that is a column of
   * prose — caps at `layout.page.measure`, which is the width of a line an eye
   * can track and return from. It is its own token rather than `type.measure`
   * so a page can be widened without changing the site's reading measure.
   *
   * `"wide"` is for the ONE shape that is not prose: a card page, which is a
   * picture with a column of facts beside it. That page has claimed to be two
   * columns since the §6a redesign and has never rendered as two, because the
   * face alone is `card.face.normal` and the measure is not wide enough to
   * seat it beside anything — so the facts column's flex basis was permanently
   * unsatisfiable and wrapped underneath, every time, at every viewport. The
   * fold that redesign describes did not exist.
   *
   * A page width is not a typographic value, and it now has a namespace of its
   * own to say so: `layout.page.wide`. This paragraph used to end "and there is
   * no token for one", which was true when it was written and became false the
   * moment the token existed — the two comments below point a reader here, so
   * it is worth stating what is actually the case rather than what was.
   *
   * The property that mattered survives the move: it is still not a number
   * anybody chose. It is a face, a gutter and a measure, added up — so the
   * facts column gets exactly the reading width every other page gets, and the
   * face gets exactly the width the face host publishes. Widening either
   * changes this on its own.
   */
  width?: "measure" | "wide";
}

const {
  title,
  description = "Legality that remembers, and rulings you can cite — a reference tool for Flesh and Blood.",
  canonical,
  section,
  headerSearch = true,
  width = "measure",
} = Astro.props;

/**
 * The absolute address this page wants to be known by.
 *
 * Built against `Astro.site` — set in `astro.config.mjs` now that the domain is
 * live — so the tag carries an origin rather than a path, which is what a
 * canonical has to be to mean anything. Defaults to the page's own URL.
 */
const canonicalPath = canonical ?? Astro.url.pathname;
/*
  NORMALISED TO ONE FORM. Astro's own `pathname` carries a trailing slash and a
  hand-written `/card/head-jab` does not, so the two sources produced
  `…/head-jab-2/` and `…/head-jab` on pages that sit beside each other. Both
  resolve, and that is exactly why it is worth fixing: a canonical whose whole
  job is to name ONE address for a document should not have two spellings.
*/
const canonicalUrl = new URL(
  canonicalPath.endsWith("/") ? canonicalPath : `${canonicalPath}/`,
  Astro.site,
);

const tokens = themeStylesheet();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl.href} />
    <!--
      The mark, in the tab. `/favicon.svg` is generated at build time from the
      same geometry the on-page mark draws from — see `src/pages/favicon.svg.ts`
      for why it is an endpoint and not a file in `public/`.

      One declaration, not the usual pile of six. An SVG icon is served to every
      engine that supports one, and browsers that do not fall back to requesting
      `/favicon.ico` on their own — which we do not ship, and which costs a 404
      on a static host rather than a wrong icon. The PNG variants an
      `apple-touch-icon` would need cannot be produced from this pipeline
      without a rasteriser in the build, so they are absent rather than
      hand-drawn: a hand-drawn one is the second copy of the mark this whole
      arrangement exists to avoid.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global set:html={tokens}></style>
  </head>
  <body>
    <div class="shell">
      {section === "none" ? null : <SiteHeader section={section === undefined ? undefined : section} field={headerSearch} />}
      <main data-width={width}>
        <slot />
      </main>
    </div>
    <ComplianceFooter />
  </body>
</html>

<style is:global>
  /*
    Document-level rules only. Anything that is a *component* belongs in
    optfall-components, not here — see the note at the top of this file.
  */
  /*
    A STICKY FOOTER, so the compliance notice sits at the foot of the SCREEN
    when a page is shorter than the viewport, and at the foot of the DOCUMENT
    when it is longer.

    The front door is where this was visibly wrong — a door is deliberately
    short, so the disclaimer floated halfway up a tall screen with nothing under
    it, reading as the end of a section rather than the end of the page. It is
    fixed here rather than on that page because it is not a property of the
    front door: any short page had it, `/data-terms` included.

    Not `position: fixed`. A pinned footer would overlay long pages and cost
    two lines of every screen forever, to solve a problem that only exists on
    short ones. A min-height flex column where the CONTENT grows pushes the
    footer down only when there is slack, which is the actual requirement.

    `100svh`, not `100vh`: on iOS, `100vh` is the height WITHOUT the browser
    chrome, so a footer anchored to it sits below the fold behind the address
    bar — the exact thing this is meant to prevent.
  */
  /*
    THE PAGE FRAME IS `looser`/`base`, NOT `loosest`/`looser`. `loosest` is the
    step for separating unlike things — a section from the section after it —
    and the edge of the viewport is not one of those. Spending it here bought a
    margin nobody reads at the cost of a heading's worth of vertical fold on
    every one of the 7,237 pages.

    The horizontal half matters more than it looks on a phone, where the old
    value was taking an eighth of the line off the one axis that has none to
    spare.
  */
  body {
    margin: 0;
    padding: var(--of-space-looser) var(--of-space-base);
    min-block-size: 100svh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background: var(--of-color-ground);
    color: var(--of-color-ink);
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-base);
    line-height: var(--of-type-leading-base);
  }

  /*
    THE SLACK GOES TO THE CONTENT, which is why this is `flex: 1 0 auto` on the
    shell rather than `margin-block-start: auto` on the footer.

    Two reasons, and the second is the load-bearing one. An auto margin would
    lose to `ComplianceFooter`'s own scoped `margin-block-start` — Astro's scope
    class raises that rule's specificity above `body > footer` — so the footer
    would silently keep its ordinary spacing and the anchoring would not happen
    at all. Growing the shell instead leaves that token in charge, so the
    hairline rule keeps the agreed distance from whatever text ends the page,
    on a short page and a long one alike.
  */
  body > .shell {
    flex: 1 0 auto;
  }

  /*
    A CONTAINER WIDTH, NOT A READING MEASURE. These were the same token until
    now, which meant the site could not widen a page without changing the line
    length of every page, and could not tune the line length without resizing
    every container. They agree numerically today and are free to stop.
  */
  main {
    max-inline-size: var(--of-layout-page-measure);
    margin-inline: auto;
  }

  /*
    A face, a gutter and a measure — see the `width` prop for why it is a sum
    rather than a chosen width. The sum now lives in the token layer as
    `layout.page.wide` rather than inline here, because a container width that
    only one stylesheet can name is a container width nothing else can build
    against: the card-page rail and the narrow-viewport case both need to know
    it. Still a MAXIMUM — a narrow viewport gets whatever it has, and the card
    page's own grid wraps to one column when it can no longer seat both.
  */
  main[data-width="wide"] {
    max-inline-size: var(--of-layout-page-wide);
  }

  /* Serif for names, questions and headings — one of the three assigned
     voices. `docs/DESIGN.md`: typography carries hierarchy, so weight and
     rhythm do the work that boxes and accent bars do on lesser sites. */
  h1,
  h2,
  h3 {
    font-family: var(--of-type-family-serif);
    font-weight: var(--of-type-weight-regular);
    line-height: var(--of-type-leading-tight);
    letter-spacing: var(--of-type-tracking-tight);

    /*
      A HEADING BELONGS TO WHAT FOLLOWS IT, so the space above it separates it
      from the previous section and the space below it is only the join to its
      own body. `loosest`/`loose` said the opposite twice over: too much lead-in
      for a page whose first heading has nothing above it to be separated FROM,
      and enough trailing space to read as a gap rather than an attachment.

      `looser`/`tight` is the same relationship stated correctly. On /cr/<id> —
      where the masthead, the rule and the apparatus heading stack — it
      compounds three times before the reader reaches the sentence they came for.
    */
    margin-block: var(--of-space-looser) var(--of-space-tight);
  }

  h1 {
    font-size: var(--of-type-size-display);
  }

  h2 {
    font-size: var(--of-type-size-title);
  }

  p {
    margin-block: 0 var(--of-space-loose);
  }

  /* Mono, wide-tracked: if it is monospaced in this system, it is something
     you can paste into an argument. */
  code {
    font-family: var(--of-type-family-sans);
    font-size: var(--of-type-size-small);
    letter-spacing: var(--of-type-tracking-wide);
    color: var(--of-color-ink-muted);

    /*
      A QUERY TOKEN HAS NO SPACES IN IT, so it is one unbreakable word to the
      line breaker, and the longest of them — `legal:cc@2026-03-14` in the
      search hint — is wider than a phone.

      This rule is here because raising `type.size.small` by one step is what
      pushed it over: the search hint's widest `code` grew past the content box
      at phone width and `/search` began scrolling sideways. Nothing else on the
      site had ever been close enough to the edge for the type scale to matter,
      which is exactly why it went unnoticed — the failure was one step of one
      token away the whole time, and no check looks at horizontal overflow.

      `anywhere` rather than `break-word`: the token must be allowed to break
      even when it is the only thing on the line, which is the case that
      actually occurs. It is also the correct default independent of the type
      scale — a reference site prints identifiers, and an identifier that
      overflows is unreadable in a way a wrapped one is not.
    */
    overflow-wrap: anywhere;
  }

  a {
    color: var(--of-color-accent);
    text-underline-offset: var(--of-space-tightest);
  }

  a:hover {
    color: var(--of-color-accent-hover);
  }

  /* Never `outline: none`. A visible focus ring is the difference between a
     keyboard being usable and being technically supported. */
  a:focus-visible,
  button:focus-visible {
    outline: var(--of-bevel-width) solid var(--of-color-focus);
    outline-offset: var(--of-space-tightest);
  }

  strong {
    font-weight: var(--of-type-weight-bold);
    color: var(--of-color-ink);
  }
</style>
