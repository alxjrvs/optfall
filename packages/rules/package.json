    "directory": "packages/rules"
  },
  "bugs": "https://github.com/alxjrvs/optfall/issues",
  "keywords": [
    "flesh-and-blood",
    "fabtcg",
    "comprehensive-rules",
    "parser"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./extract": "./src/extract.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "echo \"optfall-rules is a build-time tool; it publishes no bundle.\"",
