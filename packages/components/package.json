{
  "name": "optfall-components",
  "version": "0.0.0",
  "private": true,
  "description": "Optfall component library — Svelte primitives, compiled twice: native components for our own Astro islands, and custom elements for everyone else.",
  "license": "MIT",
  "author": "alxjrvs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alxjrvs/optfall.git",
    "directory": "packages/components"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./svelte": "./src/svelte/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc && svelte-check --tsconfig ./tsconfig.svelte.json --threshold warning",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "optfall-theme": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/svelte-vite": "10.5.7",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/jsdom": "27.0.0",
    "axe-core": "4.13.0",
    "jsdom": "28.1.0",
    "storybook": "10.5.7",
    "svelte-check": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
