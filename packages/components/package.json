{
  "name": "optfall-components",
  "version": "0.0.0",
  "private": true,
  "description": "Optfall component library — Svelte primitives, compiled twice: native components for our own Astro islands, and custom elements for everyone else.",
  "license": "MIT",
  "author": "alxjrvs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alxjrvs/optfall.git",
    "directory": "packages/components"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./svelte": "./src/svelte/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc && svelte-check --tsconfig ./tsconfig.svelte.json --threshold warning"
  },
  "dependencies": {
    "optfall-theme": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "svelte-check": "4.3.4",
    "typescript": "5.9.3"
  }
}
