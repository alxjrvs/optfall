# --- Dependencies ---------------------------------------------------------
node_modules/
.bun/
.pnp.*

# --- Build output ---------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo

# The site generator writes here; `apps/site/dist` is 12,776 pages.
apps/*/dist/

# --- Coverage -------------------------------------------------------------
coverage/
*.lcov

# --- Secrets and local environment ----------------------------------------
.env
.env.*
!.env.example
# Holds `op://` REFERENCES, never values — an address resolves to nothing
# without a 1Password session, so this one is reviewed in diffs like any other
# config. See the file's own header.
!scripts/.env.r2
*.pem
*.key

# --- Editors and OS -------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Logs -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*

# --- Deleted frameworks ---------------------------------------------------
# Astro went in Phase 6 (#107), but `apps/site/.astro/` outlives it: any tool
# that still recognises the project regenerates the type stubs, and they are
# not Biome-formatted. `biome.jsonc` sets `vcs.useIgnoreFile`, so Biome skips
# whatever git ignores — which means THIS LINE is what stops those stubs
# failing `format:check` and `lint` from the repo root. It was missing until
# the gate was measured failing on a clean checkout.
.astro/

# --- Cloudflare -----------------------------------------------------------
# `wrangler dev` and `wrangler deploy` write bundles, state and a local
# workerd cache here. Build artefacts, per-machine, never reviewed.
.wrangler/

# --- Agent worktrees ------------------------------------------------------
.claude/worktrees/
