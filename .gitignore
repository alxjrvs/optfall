# --- Dependencies ---------------------------------------------------------
node_modules/
.bun/
.pnp.*

# --- Build output ---------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo

# The site generator writes here; `apps/site/dist` is 12,776 pages.
apps/*/dist/

# --- Coverage -------------------------------------------------------------
coverage/
*.lcov

# --- Secrets and local environment ----------------------------------------
.env
.env.*
!.env.example
# Holds `op://` REFERENCES, never values — an address resolves to nothing
# without a 1Password session, so this one is reviewed in diffs like any other
# config. See the file's own header.
!scripts/.env.r2
*.pem
*.key

# --- Editors and OS -------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Logs -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*

# --- Cloudflare -----------------------------------------------------------
# `wrangler dev` and `wrangler deploy` write bundles, state and a local
# workerd cache here. Build artefacts, per-machine, never reviewed.
.wrangler/

# --- Agent worktrees ------------------------------------------------------
.claude/worktrees/

# --- Per-developer Claude Code settings -----------------------------------
# `/permissions` writes here. `.claude/settings.json` is the SHARED allowlist
# and is argued over carefully — which commands are pre-approved, and the two
# that deliberately are not. A personal grant committed into that argument
# would widen it for everyone without anyone deciding to.
.claude/settings.local.json
