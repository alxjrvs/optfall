{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run check)",
      "Bash(bun run check:*)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run format:check)",
      "Bash(bun run build)",
      "Bash(bun run design-system)",
      "Bash(bun test:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(rg:*)",
      "Bash(git worktree list:*)"
    ]
  }
}
