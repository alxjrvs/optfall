{
  "name": "optfall",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Legality that remembers, and rulings you can cite — a reference tool for Flesh and Blood.",
  "homepage": "https://github.com/alxjrvs/optfall",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alxjrvs/optfall.git"
  },
  "author": "alxjrvs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "catalog": {
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "@types/jsdom": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "vite": "8.3.4"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && bun run --filter './packages/*' --filter './apps/*' typecheck",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "build": "bun run --filter './packages/*' --filter './apps/*' build",
    "check": "bun run format:check && bun run lint && bun run check:tokens && bun run check:faint-ink && bun run check:bun-version && bun run check:provenance && bun run check:no-llm && bun run check:ci-aggregator && bun run typecheck && bun run test",
    "check:full": "bun run check && bun run build && bun run check:disclaimer && bun run check:built-tokens && bun run check:card-notice && bun run check:a11y && bun run check:dev-server",
    "check:ci-aggregator": "bun scripts/check-ci-aggregator.ts",
    "check:no-llm": "bun scripts/check-no-llm-deps.ts",
    "check:disclaimer": "bun scripts/check-disclaimer.ts",
    "check:card-notice": "bun scripts/check-card-notice.ts",
    "check:a11y": "bun scripts/check-a11y.ts",
    "check:tokens": "bun scripts/check-tokens.ts",
    "check:faint-ink": "bun scripts/check-faint-ink.ts",
    "check:bun-version": "bun scripts/check-bun-version.ts",
    "check:built-tokens": "bun scripts/check-built-tokens.ts",
    "check:dev-server": "bun scripts/check-dev-server.ts",
    "check:provenance": "bun scripts/check-asset-provenance.ts",
    "check:coverage": "bun scripts/check-coverage.ts",
    "check:symbols": "bun scripts/ingest-game-symbols.ts --check",
    "check:face-orientation": "bun scripts/check-face-orientation.ts",
    "check:design-system": "bun test scripts/design-system-coverage.test.ts",
    "symbols": "bun scripts/ingest-game-symbols.ts",
    "corpus:rules": "bun scripts/build-rules-corpus.ts",
    "corpus:cards": "bun scripts/build-card-corpus.ts",
    "corpus:sets": "bun scripts/build-sets-corpus.ts",
    "corpus:sample": "bun scripts/build-card-sample.ts",
    "design-system": "bun scripts/build-design-system.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@happy-dom/global-registrator": "21.0.3",
    "@types/bun": "1.4.0",
    "sharp": "catalog:",
    "typescript": "7.0.2",
    "wrangler": "4.151.0",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "@types/jsdom": "catalog:"
  }
}
