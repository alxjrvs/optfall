{
  "name": "optfall",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Legality that remembers, and rulings you can cite — a reference tool for Flesh and Blood.",
  "homepage": "https://github.com/alxjrvs/optfall",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alxjrvs/optfall.git"
  },
  "author": "alxjrvs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && bun run --filter './packages/*' --filter './apps/*' typecheck",
    "lint": "oxlint --deny-warnings",
    "test": "bun test",
    "build": "bun run --filter './packages/*' --filter './apps/*' build",
    "check": "bun run typecheck && bun run lint && bun run test",
    "check:disclaimer": "bun scripts/check-disclaimer.ts",
    "check:tokens": "bun scripts/check-tokens.ts",
    "check:repo-settings": "scripts/repo-settings.sh --check",
    "check:built-tokens": "bun scripts/check-built-tokens.ts",
    "corpus:rules": "bun scripts/build-rules-corpus.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxlint": "1.77.0",
    "typescript": "7.0.2"
  }
}
